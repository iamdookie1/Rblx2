local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local REPO_RAW_BASE = 'https://raw.githubusercontent.com/iamdookie1/Rblx2/main/'
local WATCH_DURATION = 5

-- Maps a PlaceId to the game-specific script hosted in this repo's Games/ folder.
local Games = {
    [9391468976] = { Name = 'Jujutsu Shenanigans', Script = 'Games/Jjs' },
    [155615604] = { Name = 'Prison Life', Script = 'Games/PrisonLife.lua' },
    [2768379856] = { Name = '3008', Script = 'Games/3008.lua' },
    [119789365111500] = { Name = 'Tanks', Script = 'Games/Tanks.lua' },
    [7871169780] = { Name = 'Minesweeper', Script = 'Games/Minesweeper.lua' },
    [662417684] = { Name = 'Lucky Blocks', Script = 'Games/LuckyBlocks.lua' },
    [129363360542125] = { Name = 'Doodle Drop', Script = 'Games/DoodleDrop.lua' },
    -- Doodle Drop's level creator, from UGC_PLACE_ID in the game's own Config.
    -- Its Config flips IS_UGC on that place, so the solver works on both.
    [107331150688830] = { Name = 'Doodle Drop (create)', Script = 'Games/DoodleDrop.lua' },
    -- Lucky Blocks boots you here after 19 idle minutes, from the place id in
    -- its own afk_connection script. The hub loads on both so a session that
    -- gets sent over keeps its menu.
    [15626342566] = { Name = 'Lucky Blocks (afk server)', Script = 'Games/LuckyBlocks.lua' },
    -- 3008's testing place, from a PlaceId check in the game's own source.
    -- Kept alongside the public place so the hub works on both.
    [2788336572] = { Name = '3008 (test place)', Script = 'Games/3008.lua' },
    [84637477108843] = { Name = 'Build an AI', Script = 'Games/BuildAnAI.lua' },
}

-- The UI ships in this repo now, so the hub and everything it loads are
-- versioned together: a change to the library lands with the scripts written
-- against it instead of drifting in a second repo.
local Centrl = loadstring(game:HttpGet(REPO_RAW_BASE .. 'UI/Lib2.lua'))()

local Window = Centrl:Window({
    Title = 'hub',
    SubTitle = 'game loader',
    Folder = 'Hub',
    ToggleKey = Enum.KeyCode.RightShift,
    Accent = Color3.fromRGB(60, 140, 255),
})

-- One rail entry holding three real pages, rather than three rail entries for
-- what is one screen's worth of loader.
local HubTab = Window:Tab({ Title = 'hub', Icon = 'gamepad-2' })

local LoadPage = HubTab:Tab({ Title = 'load', Icon = 'play' })
local GamesPage = HubTab:Tab({ Title = 'games', Icon = 'list' })
local SessionPage = HubTab:Tab({ Title = 'session', Icon = 'info' })

--// load ---------------------------------------------------------------------

local Status = LoadPage:Section({ Title = 'status', Side = 'left' })
local Load = LoadPage:Section({ Title = 'load', Side = 'right' })

local PlaceStat = Status:Stat({ Title = 'place id', Value = tostring(game.PlaceId) })
local DetectedStat = Status:Stat({ Title = 'detected', Value = 'searching...' })
local ScriptStat = Status:Stat({ Title = 'script', Value = '-' })

local Log = Status:Console({ Title = 'log', Height = 110, MaxLines = 60, Timestamps = true })
Log:Add('watching for a supported game...')

local MatchedGame = nil
local Loaded = false

local function runMatched()
    if not MatchedGame then
        Log:Warn('nothing to load')
        return
    end
    if Loaded then
        Log:Warn('already loaded — rejoin to load again')
        return
    end

    local url = REPO_RAW_BASE .. MatchedGame.Script
    Log:Add('fetching ' .. MatchedGame.Script)

    local ok, source = pcall(game.HttpGet, game, url)
    if not ok then
        Log:Error('fetch failed: ' .. tostring(source))
        return
    end

    local loader, compileError = loadstring(source)
    if not loader then
        -- Compiling before unloading the menu, so a broken script leaves the
        -- hub on screen with the reason instead of taking it down with it.
        Log:Error('compile failed: ' .. tostring(compileError))
        return
    end

    Loaded = true
    Log:Success('running ' .. MatchedGame.Name)
    Centrl:Unload()
    loader()
end

Load:Buttons({
    { Title = 'load game', Callback = runMatched },
    {
        Title = 'copy place id',
        Callback = function()
            if setclipboard then
                setclipboard(tostring(game.PlaceId))
                Log:Add('place id copied')
            else
                Log:Warn('no setclipboard in this executor')
            end
        end,
    },
})

Load:Button({
    Title = 'unload hub',
    Callback = function()
        Centrl:Unload()
    end,
})

--// games --------------------------------------------------------------------

local Supported = GamesPage:Section({ Title = 'supported games', Side = 'left' })

-- Sorted by name so the list is stable between sessions; pairs over a table
-- keyed by PlaceId would shuffle it every run.
local ordered = {}
for placeId, entry in pairs(Games) do
    table.insert(ordered, { PlaceId = placeId, Name = entry.Name, Script = entry.Script })
end
table.sort(ordered, function(a, b)
    return a.Name:lower() < b.Name:lower()
end)

for _, entry in ipairs(ordered) do
    local here = entry.PlaceId == game.PlaceId
    Supported:Stat({
        Title = entry.Name,
        Value = tostring(entry.PlaceId),
        Color = here and Color3.fromRGB(126, 217, 87) or nil,
    })
end

GamesPage:SetBadge(tostring(#ordered))

local Jump = GamesPage:Section({ Title = 'open', Side = 'right' })

local jumpChoice = ordered[1] and ordered[1].Name or nil
local jumpNames = {}
for index, entry in ipairs(ordered) do
    jumpNames[index] = entry.Name
end

Jump:Dropdown({
    Title = 'game',
    Values = jumpNames,
    Default = jumpChoice,
    Callback = function(value)
        jumpChoice = value
    end,
})

Jump:Button({
    Title = 'copy loadstring',
    Callback = function()
        for _, entry in ipairs(ordered) do
            if entry.Name == jumpChoice then
                if not setclipboard then
                    Log:Warn('no setclipboard in this executor')
                    return
                end
                setclipboard(("loadstring(game:HttpGet('%s%s'))()"):format(REPO_RAW_BASE, entry.Script))
                Log:Add('loadstring for ' .. entry.Name .. ' copied')
                return
            end
        end
    end,
})

Jump:Label({
    Text = 'The hub only runs a script when you are already in its place. Copy a loadstring here to run one by hand.',
})

--// session ------------------------------------------------------------------

local Session = SessionPage:Section({ Title = 'session', Side = 'left' })

local executor = 'unknown'
if identifyexecutor then
    local ok, name = pcall(identifyexecutor)
    if ok and name then
        executor = tostring(name)
    end
end

Session:Stat({ Title = 'executor', Value = executor })
Session:Stat({ Title = 'player', Value = Players.LocalPlayer and Players.LocalPlayer.Name or '-' })
Session:Stat({ Title = 'place id', Value = tostring(game.PlaceId) })
Session:Stat({ Title = 'job id', Value = game.JobId ~= '' and game.JobId or 'studio' })

local Menu = SessionPage:Section({ Title = 'menu', Side = 'right' })

Menu:Label({ Text = 'Right Shift toggles the menu. Everything under settings — accent, scale, configs — is saved per folder.' })

Menu:Button({
    Title = 'copy job id',
    Callback = function()
        if setclipboard then
            setclipboard(tostring(game.JobId))
            Log:Add('job id copied')
        else
            Log:Warn('no setclipboard in this executor')
        end
    end,
})

Window:Load()

-- Watch for a supported game for up to WATCH_DURATION seconds after load, then
-- stop. PlaceId is set before this ever runs in practice, but a slow join can
-- still be mid-swap when the hub is executed.
task.spawn(function()
    local start = os.clock()
    while os.clock() - start < WATCH_DURATION do
        local match = Games[game.PlaceId]
        if match then
            MatchedGame = match
            PlaceStat:Set(tostring(game.PlaceId))
            DetectedStat:Set(match.Name, Color3.fromRGB(126, 217, 87))
            ScriptStat:Set(match.Script)
            HubTab:SetBadge('1')
            LoadPage:SetBadge('!')
            Log:Success(match.Name .. ' detected')
            Centrl:Notify({
                Title = 'hub',
                Content = match.Name .. ' detected. Press "load game" to run it.',
                Type = 'success',
                Duration = 5,
            })
            return
        end
        RunService.Heartbeat:Wait()
    end

    DetectedStat:Set('unsupported', Color3.fromRGB(255, 96, 106))
    Log:Warn('no supported game for place ' .. tostring(game.PlaceId))
end)
