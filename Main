local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local REPO_RAW_BASE = 'https://raw.githubusercontent.com/iamdookie1/Rblx2/main/'
local WATCH_DURATION = 5

-- Maps a PlaceId to the game-specific script hosted in this repo's Games/ folder.
local Games = {
    [9391468976] = { Name = 'Jujutsu Shenanigans', Script = 'Games/Jjs' },
    [155615604] = { Name = 'Prison Life', Script = 'Games/PrisonLife.lua' },
    -- Real MM2 place id, confirmed from a fresh script dump's own PlaceId
    -- check (ReplicatedFirst.UISelector.Loading). Alternate/test place ids
    -- also seen in that dump (335132309, 333740520, 5895823254, 5928494131,
    -- 636649648) weren't registered - no way to tell from the dump alone
    -- whether those are still live, mobile-only, or long since retired.
    [142823291] = { Name = 'Murder Mystery 2', Script = 'Games/MM2.lua' },
    [2768379856] = { Name = '3008', Script = 'Games/3008.lua' },
    [119789365111500] = { Name = 'Tanks', Script = 'Games/Tanks.lua' },
    [7871169780] = { Name = 'Minesweeper', Script = 'Games/Minesweeper.lua' },
    [662417684] = { Name = 'Lucky Blocks', Script = 'Games/LuckyBlocks.lua' },
    [129363360542125] = { Name = 'Doodle Drop', Script = 'Games/DoodleDrop.lua' },
    -- Doodle Drop's level creator, from UGC_PLACE_ID in the game's own Config.
    -- Its Config flips IS_UGC on that place, so the solver works on both.
    [107331150688830] = { Name = 'Doodle Drop (create)', Script = 'Games/DoodleDrop.lua' },
    -- Lucky Blocks boots you here after 19 idle minutes, from the place id in
    -- its own afk_connection script. The hub loads on both so a session that
    -- gets sent over keeps its menu.
    [15626342566] = { Name = 'Lucky Blocks (afk server)', Script = 'Games/LuckyBlocks.lua' },
    -- 3008's testing place, from a PlaceId check in the game's own source.
    -- Kept alongside the public place so the hub works on both.
    [2788336572] = { Name = '3008 (test place)', Script = 'Games/3008.lua' },
    -- Confirmed via web search against this place id: "Fling Things and
    -- People" by Horomori, a sandbox where you grab and throw props and
    -- other players.
    [6961824067] = { Name = 'Fling Things and People', Script = 'Games/FlingThingsAndPeople.lua' },
}

-- The UI ships in this repo now, so the hub and everything it loads are
-- versioned together: a change to the library lands with the scripts written
-- against it instead of drifting in a second repo.
--
-- raw.githubusercontent.com caches the branch URL, so a fresh push can still
-- serve a stale copy for a while. Resolving the branch's current commit sha
-- first and fetching that exact commit sidesteps it, since a commit sha is
-- immutable - falls back to the branch URL if the API call fails for any
-- reason (rate limited, offline, etc).
local function resolveLatestRef()
    local ref = 'main'
    pcall(function()
        local commit = HttpService:JSONDecode(game:HttpGet('https://api.github.com/repos/iamdookie1/Rblx2/commits/main'))
        if commit and commit.sha then
            ref = commit.sha
        end
    end)
    return ref
end

local Onyx = loadstring(game:HttpGet(('https://raw.githubusercontent.com/iamdookie1/Rblx2/%s/UI/Ui2.lua'):format(resolveLatestRef())))()

-- Onyx has no Stat element, just a Label. This gives every Section the same
-- Title/Value pair with a live :Set(value, color) that the rest of this file
-- already expects, so the rest of the loader reads the same as it always has.
local function addStat(section, cfg)
    local title = cfg.Title
    local label = section:Label({ Title = title .. ': ' .. tostring(cfg.Value), Color = cfg.Color })
    local api = {}
    function api.Set(value, color)
        label:SetText(title .. ': ' .. tostring(value))
        if color then label:SetColor(color) end
    end
    return api
end

local Window = Onyx:CreateWindow({
    Title = 'hub',
    SubTitle = 'game loader',
    Folder = 'Hub',
    Keybind = Enum.KeyCode.RightShift,
    Accent = Color3.fromRGB(60, 140, 255),
})

local LoadTab = Window:CreateTab({ Title = 'load', Default = true })
local GamesTab = Window:CreateTab({ Title = 'games' })
local SessionTab = Window:CreateTab({ Title = 'session' })

--// load ---------------------------------------------------------------------

local Status = LoadTab:CreateSection('status')
local Load = LoadTab:CreateSection('load')

local PlaceStat = addStat(Status, { Title = 'place id', Value = tostring(game.PlaceId) })
local DetectedStat = addStat(Status, { Title = 'detected', Value = 'searching...' })
local ScriptStat = addStat(Status, { Title = 'script', Value = '-' })

local Log = Status:Console({ Title = 'log', Height = 110, MaxLines = 60, Timestamps = true })
Log:Log('watching for a supported game...')

local MatchedGame = nil
local Loaded = false

local function runScript(entry)
    if not entry then
        Log:Warn('nothing to load')
        return
    end
    if Loaded then
        Log:Warn('already loaded — rejoin to load again')
        return
    end

    local url = REPO_RAW_BASE .. entry.Script
    Log:Log('fetching ' .. entry.Script)

    local ok, source = pcall(game.HttpGet, game, url)
    if not ok then
        Log:Error('fetch failed: ' .. tostring(source))
        return
    end

    local loader, compileError = loadstring(source)
    if not loader then
        -- Compiling before unloading the menu, so a broken script leaves the
        -- hub on screen with the reason instead of taking it down with it.
        Log:Error('compile failed: ' .. tostring(compileError))
        return
    end

    Loaded = true
    Log:Success('running ' .. entry.Name)
    Onyx:Unload()
    loader()
end

local function runMatched()
    runScript(MatchedGame)
end

Load:Button({ Title = 'load game', Callback = runMatched })

Load:Button({
    Title = 'copy place id',
    Callback = function()
        if setclipboard then
            setclipboard(tostring(game.PlaceId))
            Log:Log('place id copied')
        else
            Log:Warn('no setclipboard in this executor')
        end
    end,
})

Load:Button({
    Title = 'unload hub',
    Callback = function()
        Onyx:Unload()
    end,
})

--// games --------------------------------------------------------------------

local Supported = GamesTab:CreateSection('supported games')

-- Sorted by name so the list is stable between sessions; pairs over a table
-- keyed by PlaceId would shuffle it every run.
local ordered = {}
for placeId, entry in pairs(Games) do
    table.insert(ordered, { PlaceId = placeId, Name = entry.Name, Script = entry.Script })
end
table.sort(ordered, function(a, b)
    return a.Name:lower() < b.Name:lower()
end)

for _, entry in ipairs(ordered) do
    local here = entry.PlaceId == game.PlaceId
    addStat(Supported, {
        Title = entry.Name,
        Value = tostring(entry.PlaceId),
        Color = here and Color3.fromRGB(126, 217, 87) or nil,
    })
end

local Jump = GamesTab:CreateSection('open')

local jumpChoice = ordered[1] and ordered[1].Name or nil
local jumpNames = {}
for index, entry in ipairs(ordered) do
    jumpNames[index] = entry.Name
end

Jump:Dropdown({
    Title = 'game',
    Values = jumpNames,
    Default = jumpChoice,
    Callback = function(value)
        jumpChoice = value
    end,
})

Jump:Button({
    Title = 'copy loadstring',
    Callback = function()
        for _, entry in ipairs(ordered) do
            if entry.Name == jumpChoice then
                if not setclipboard then
                    Log:Warn('no setclipboard in this executor')
                    return
                end
                setclipboard(("loadstring(game:HttpGet('%s%s'))()"):format(REPO_RAW_BASE, entry.Script))
                Log:Log('loadstring for ' .. entry.Name .. ' copied')
                return
            end
        end
    end,
})

Jump:Label('The hub only runs a script when you are already in its place. Copy a loadstring here to run one by hand.')

--// session ------------------------------------------------------------------

local Session = SessionTab:CreateSection('session')

local executor = 'unknown'
if identifyexecutor then
    local ok, name = pcall(identifyexecutor)
    if ok and name then
        executor = tostring(name)
    end
end

addStat(Session, { Title = 'executor', Value = executor })
addStat(Session, { Title = 'player', Value = Players.LocalPlayer and Players.LocalPlayer.Name or '-' })
addStat(Session, { Title = 'place id', Value = tostring(game.PlaceId) })
addStat(Session, { Title = 'job id', Value = game.JobId ~= '' and game.JobId or 'studio' })

local Menu = SessionTab:CreateSection('menu')

Menu:Label('Right Shift toggles the menu. Everything under settings — accent, scale, configs — is saved per folder.')

Menu:Button({
    Title = 'copy job id',
    Callback = function()
        if setclipboard then
            setclipboard(tostring(game.JobId))
            Log:Log('job id copied')
        else
            Log:Warn('no setclipboard in this executor')
        end
    end,
})

-- Watch for a supported game for up to WATCH_DURATION seconds after load, then
-- stop. PlaceId is set before this ever runs in practice, but a slow join can
-- still be mid-swap when the hub is executed.
task.spawn(function()
    local start = os.clock()
    while os.clock() - start < WATCH_DURATION do
        local match = Games[game.PlaceId]
        if match then
            MatchedGame = match
            PlaceStat.Set(tostring(game.PlaceId))
            DetectedStat.Set(match.Name, Color3.fromRGB(126, 217, 87))
            ScriptStat.Set(match.Script)
            Log:Success(match.Name .. ' detected')
            Onyx:Notify({
                Title = 'hub',
                Content = match.Name .. ' detected. Press "load game" to run it.',
                Type = 'success',
                Duration = 5,
            })
            return
        end
        RunService.Heartbeat:Wait()
    end

    DetectedStat.Set('unsupported', Color3.fromRGB(255, 96, 106))
    Log:Warn('no supported game for place ' .. tostring(game.PlaceId))
end)
