-- The dump carries no world positions, so the map's extents are measured live
-- rather than hardcoded - that also means this keeps working if the arena
-- changes.
local function getMapBounds()
    local map = workspace:FindFirstChild("Map")
    if not map then return nil end
    local ok, cf, size = pcall(function()
        local a, b = map:GetBoundingBox()
        return a, b
    end)
    if not ok or not cf or not size then return nil end
    return cf.Position, size
end

-- Somewhere past the edge of the arena, at altitude. Height is what keeps this
-- survivable: we sit above the map rather than dropping to the kill plane, so
-- the victim is the only one who falls.
local function computeVoidPoint(fromPosition)
    local center, size = getMapBounds()
    if not center then return nil end
    local half = size / 2

    -- Leave by whichever horizontal axis we are already nearest to, so the
    -- trip out is as short as possible.
    local dx = fromPosition.X - center.X
    local dz = fromPosition.Z - center.Z
    local outX, outZ
    if math.abs(dx) / math.max(half.X, 1) >= math.abs(dz) / math.max(half.Z, 1) then
        outX = center.X + (dx >= 0 and 1 or -1) * (half.X + VoidConfig.VoidMargin)
        outZ = fromPosition.Z
    else
        outX = fromPosition.X
        outZ = center.Z + (dz >= 0 and 1 or -1) * (half.Z + VoidConfig.VoidMargin)
    end

    local topY = center.Y + half.Y + VoidConfig.Clearance
    return Vector3.new(outX, topY, outZ), topY
end

local moveParams = RaycastParams.new()
moveParams.FilterType = Enum.RaycastFilterType.Exclude
moveParams.IgnoreWater = true

-- Incremental, raycast-checked movement. The point of stepping instead of
-- teleporting is that every step is verified against geometry first, so the
-- character never passes through a wall - which is the thing most likely to be
-- noticed, far more than speed is.
local function flyTo(goal, victimChar, deadline)
    local root = getOwnRoot()
    if not root then return false end

    local ignore = { getOwnCharacter() }
    if victimChar then ignore[#ignore + 1] = victimChar end
    moveParams.FilterDescendantsInstances = ignore

    while tick() < deadline do
        root = getOwnRoot()
        if not root then return false end

        local current = root.Position
        local delta = goal - current
        local distance = delta.Magnitude
        if distance <= 2 then return true end

        local dt = RunService.Heartbeat:Wait()
        local stepLength = math.min(VoidConfig.FlySpeed * dt, distance)
        local direction = delta.Unit
        local nextPos = current + direction * stepLength

        local blocked = workspace:Raycast(current, nextPos - current, moveParams)
        if blocked then
            -- Something is in the way: climb over it rather than through it,
            -- and let the next iteration retry the horizontal leg.
            local lift = current + Vector3.new(0, VoidConfig.StepBlockedLift, 0)
            local liftBlocked = workspace:Raycast(current, Vector3.new(0, VoidConfig.StepBlockedLift, 0), moveParams)
            if liftBlocked then
                return false
            end
            root.CFrame = CFrame.new(lift, lift + Vector3.new(direction.X, 0, direction.Z))
        else
            local lookAt = nextPos + Vector3.new(direction.X, 0, direction.Z)
            if (Vector3.new(direction.X, 0, direction.Z)).Magnitude < 0.01 then
                lookAt = nextPos + root.CFrame.LookVector
            end
            root.CFrame = CFrame.new(nextPos, lookAt)
        end
    end

    return false
end

local function runVoidCarry(victimChar)
    if carryActive or not VoidConfig.Enabled then return end

    local root = getOwnRoot()
    if not root then return end

    carryActive = true
    local origin = root.CFrame
    VoidConfig.Status = "carrying"
    VoidConfig.LastFollowGap = -1

    local finished = false
    local function restore()
        if finished then return end
        finished = true
        local rootNow = getOwnRoot()
        if rootNow then rootNow.CFrame = origin end
        carryActive = false
    end

    task.spawn(function()
        local ok = pcall(function()
            local voidPoint, safeY = computeVoidPoint(root.Position)
            if not voidPoint then
                VoidConfig.Status = "no Map to measure"
                return
            end

            local hardDeadline = tick() + 6

            -- Straight up first: clears whatever is around without touching it.
            local rise = Vector3.new(root.Position.X, safeY, root.Position.Z)
            if not flyTo(rise, victimChar, hardDeadline) then
                VoidConfig.Status = "blocked on ascent"
                return
            end

            if not flyTo(voidPoint, victimChar, hardDeadline) then
                VoidConfig.Status = "blocked crossing out"
                return
            end

            VoidConfig.Status = "over the void"

            -- Hold position while the victim is out here with us, and watch
            -- whether they are actually following. If the server does not keep
            -- them attached through the combo this gap grows immediately, which
            -- is the honest signal that the carry did nothing.
            local holdUntil = tick() + VoidConfig.CarryDuration
            while tick() < holdUntil do
                local rootNow = getOwnRoot()
                local hum = getOwnHumanoid()
                if not rootNow or not hum or hum.Health <= 0 then break end

                rootNow.CFrame = CFrame.new(voidPoint, voidPoint + rootNow.CFrame.LookVector)

                if victimChar then
                    local victimRoot = victimChar:FindFirstChild("HumanoidRootPart")
                    if victimRoot then
                        VoidConfig.LastFollowGap = (victimRoot.Position - rootNow.Position).Magnitude
                    end
                end

                RunService.Heartbeat:Wait()
            end

            VoidConfig.Status = "returning"
        end)

        if not ok then
            VoidConfig.Status = "errored"
        end
        restore()
        if VoidConfig.Status == "returning" or VoidConfig.Status == "over the void" then
            VoidConfig.Status = "done"
        end
    end)
end

if CursedStrikesEffects then
    CursedStrikesEffects.OnClientEvent:Connect(function(key, a, b)
        if not VoidConfig.Enabled or carryActive then return end

        if key == "FinalHit" then
            -- FinalHit(attacker, victim): unambiguous, no window needed.
            if isOwnCharacter(a) and b and not isOwnCharacter(b) then
                runVoidCarry(b)
            end
        elseif key == "Hit" then
            -- Hit(victim, ...): only ours if we just used the move.
            if tick() - lastActivatedAt <= ACTIVATION_WINDOW and a and not isOwnCharacter(a) then
                runVoidCarry(a)
            end
        end
    end)
end

