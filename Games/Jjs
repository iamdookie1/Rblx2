}

-- Dash cooldown changer: hooks MovementController.DashRequest so a custom
-- cooldown applies to Back/Left/Right dashes. Front dash is a separate
-- "chase" ability (routed to the original handler untouched) since it
-- doesn't go through the same movement-dash cooldown or remote at all.
local LastCustomDash = 0
local OriginalDashRequest = nil

local function getMovementController()
    local ok, controller = pcall(function()
        return Knit.GetController("MovementController")
    end)
    if ok then return controller end
    return nil
end

local function getDashDirection(humanoid, hrp)
    local camLook = workspace.CurrentCamera.CFrame.LookVector
    local flat = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camLook.X, 0, camLook.Z))
    local forward = math.round(humanoid.MoveDirection:Dot(flat.LookVector))
    local right = math.round(humanoid.MoveDirection:Dot(flat.RightVector))
    if forward == 1 then return "Front" end
    if forward == -1 then return "Back" end
    if right == 1 then return "Right" end
    if right == -1 then return "Left" end
    return "Front"
end

local function hookDashRequest()
    if OriginalDashRequest then return true end

    local Controller = getMovementController()
    if not Controller then return false end

    OriginalDashRequest = Controller.DashRequest

    Controller.DashRequest = function(self, ...)
        if not DashConfig.Enabled then
            return OriginalDashRequest(self, ...)
        end

        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local info = character and character:FindFirstChild("Info")
        if not (character and hrp and humanoid and info) then
            return OriginalDashRequest(self, ...)
        end

        -- Unconditional knockback/burst escape dash: never gated by cooldown.
        if info:FindFirstChild("Knockback")
            or (character:GetAttribute("Burst") and not info:GetAttribute("Burst"))
            or (info:FindFirstChild("ForceEsc") and info.ForceEsc.Value) then
            return OriginalDashRequest(self, ...)
        end

        local direction = getDashDirection(humanoid, hrp)
        if direction == "Front" then
            return OriginalDashRequest(self, ...)
        end

        -- Preserve the game's own movement-state guards; only the cooldown changes.
        if info:FindFirstChild("Block") then return end
        if info:FindFirstChild("Stun") then return end
        if character:GetAttribute("Ragdoll") > 0 then return end
        local inSkill = info:FindFirstChild("InSkill")
        if inSkill and inSkill.Value == false then return end
        if info:FindFirstChild("NoDash") then return end
        local noSprint = info:FindFirstChild("NoSprint")
        if noSprint and noSprint.Value == false then return end

        if tick() - LastCustomDash < DashConfig.Cooldown then return end
        LastCustomDash = tick()

        DashRemote:FireServer(direction)
        self:Dash(LocalPlayer, character, direction)
    end

    return true
end

local function getCharFolder()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then return nil end
    return chars:FindFirstChild(LocalPlayer.Name)
end

local function getDivergentFistArg()
    local folder = getCharFolder()
    if not folder then return nil end
    local moveset = folder:FindFirstChild("Moveset")
    if not moveset then return nil end
    return moveset:FindFirstChild("Divergent Fist")
end

local function hookTrack(track, id)
    local variant = DIVERGENT_IDS[id]
    if not variant then return end

    if variant == 4 then
        task.delay(VARIANT4_DELAY, function()
            if not Config.Enabled then return end
            if not track.IsPlaying then return end
            RightActivated:FireServer()
        end)
        return
    end

    local shouldFire = math.random(1, 100) <= Config.Chance
    if not shouldFire then return end

    task.delay(BLACKFLASH_DELAY, function()
        if not Config.Enabled then return end
        if not track.IsPlaying then return end
        local arg = getDivergentFistArg()
        if arg then
            Activated:FireServer(arg)
        end
    end)
end

local function connectHumanoid(hum)
    hum.AnimationPlayed:Connect(function(track)
        if not Config.Enabled then return end
        local id = track.Animation and track.Animation.AnimationId
        if id then
            hookTrack(track, id)
        end
    end)
end

local function onCharacterAdded(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
        or char:WaitForChild("Humanoid", 5)
    if hum then
        connectHumanoid(hum)
    end
end

local function watchForCharacter()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then
        workspace.ChildAdded:Connect(function(child)
            if child.Name == "Characters" then
                local playerFolder = child:WaitForChild(LocalPlayer.Name, 10)
                if playerFolder then
                    onCharacterAdded(playerFolder)
                    playerFolder.ChildAdded:Connect(function(child2)
                        if child2:IsA("Humanoid") then
                            connectHumanoid(child2)
                        end
                    end)
                end
            end
        end)
        return
    end

    local playerFolder = chars:FindFirstChild(LocalPlayer.Name)
    if playerFolder then
        onCharacterAdded(playerFolder)
        playerFolder.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then
                connectHumanoid(child)
            end
        end)
    else
        chars.ChildAdded:Connect(function(child)
            if child.Name == LocalPlayer.Name then
                onCharacterAdded(child)
                child.ChildAdded:Connect(function(child2)
                    if child2:IsA("Humanoid") then
                        connectHumanoid(child2)
                    end
                end)
            end
        end)
    end
end

watchForCharacter()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    watchForCharacter()
end)

task.spawn(function()
    for _ = 1, 20 do
        if hookDashRequest() then return end
        task.wait(0.5)
    end
end)


--// Combat intel ------------------------------------------------------------
-- Everything below reads state the server already replicates. Nothing here is
-- a guess about server internals except where it says so.
--
-- Three facts make it work, all confirmed against the dump:
--
--   1. Every move is a Knit service with an `RE.Effects` RemoteEvent that the
--      server broadcasts to *all* clients as (effectName, ...). The controllers
--      use it purely for VFX, and the first argument is the acting character.
--      That is the only announcement of "someone started doing something" that
--      reaches us, and it reaches us for everyone on the server.
--
--   2. Character state is instances in `character.Info` - Stun, Block, IFrame,
--      InSkill, NoBlock, Wakeup - created by the server and deleted by a
--      server-side Debris timer. So we can see that someone is stunned and
--      when it ends, but the *length* never crosses the wire. It has to be
--      measured.
--
--   3. Each move under `character.Moveset` carries a `ReadyAt` attribute, an
--      absolute time compared against workspace:GetServerTimeNow(). Cooldowns
--      are readable, exactly, for our own moves.
--
-- What is NOT readable, and no amount of client code changes this: whether a
-- given attack is blockable, whether it is 360-blockable, and what attack type
-- it is (which is what decides whether a counter catches it). Those live in
-- server scripts. The timing table below is the workaround - it does not learn
-- *whether* a move can be blocked, it learns *how long you have to react*, and
-- everything defensive here gates on that instead.

local Intel = {
    -- Rolling feed of move announcements, newest last.
    Feed = {},
    FeedLimit = 60,
    -- key -> { n, lead, dur, ragdoll } running means, keyed "Service.Effect".
    Timing = {},
    -- Events seen recently, used to attribute a stun to whatever caused it.
    Recent = {},
    RecentWindow = 2.5,
    Learning = true,
    Samples = 0,
    Hooked = 0,
}

local IntelConfig = {
    Enabled = false,
    Range = 90,
    LogFeed = true,
}

-- Effect names that fire on impact rather than on startup. Reacting to these
-- is pointless - the hit has already happened - so they are excluded from the
-- attack feed and from every defensive trigger.
local IMPACT_EFFECTS = {
    Hit = true, FinalHit = true, Hurt = true, Impact = true, Land = true,
    Explode = true, Explosion = true, Blocked = true, Kill = true,
    Death = true, End = true, Finish = true, Cancel = true, Stop = true,
    Deactivate = true, Slam = true, Burst = true, TrueRagdoll = true,
}

local function serverNow()
    local ok, value = pcall(function()
        return workspace:GetServerTimeNow()
    end)
    if ok and type(value) == 'number' then
        return value
    end
    return tick()
end

local function charactersFolder()
    return workspace:FindFirstChild("Characters")
end

local function ownCharacter()
    local folder = charactersFolder()
    local mine = folder and folder:FindFirstChild(LocalPlayer.Name)
    if mine and mine:FindFirstChild("HumanoidRootPart") then
        return mine
    end
    -- The game keeps a copy under Player.Character too, and which one is live
    -- depends on how far into a respawn we are.
    local fallback = LocalPlayer.Character
    if fallback and fallback:FindFirstChild("HumanoidRootPart") then
        return fallback
    end
    return nil
end

local function isOwn(model)
    if not model then return false end
    return model.Name == LocalPlayer.Name or model == LocalPlayer.Character
end

-- State reads. All of these work on any character, not just ours.

local function infoOf(char)
    return char and char:FindFirstChild("Info") or nil
end

local function hasState(char, name)
    local info = infoOf(char)
    return info ~= nil and info:FindFirstChild(name) ~= nil
end

local function isRagdolled(char)
    if not char then return false end
    return (char:GetAttribute("Ragdoll") or 0) > 0
end

-- The one question that decides whether any of the automation may act.
local function canAct(char)
    if not char then return false, 'no character' end
    if char:GetAttribute("Dead") then return false, 'dead' end
    if isRagdolled(char) then return false, 'ragdolled' end
    if hasState(char, 'Stun') then return false, 'stunned' end
    if hasState(char, 'InSkill') then return false, 'in a skill' end
    if hasState(char, 'Cancel') then return false, 'cancelled' end
    return true, 'ready'
end

local function evadeMeter(char)
    if not char then return 0 end
    return char:GetAttribute("Evade") or 0
end

-- The game treats "can burst" as the character attribute being set while the
-- Info-folder one is not - the second is the spent/cooldown marker.
local function canBurst(char)
    if not char then return false end
    local info = infoOf(char)
    return (char:GetAttribute("Burst") and true or false)
        and not (info and info:GetAttribute("Burst"))
end

-- Cooldowns. `ReadyAt` is an absolute server timestamp on the move instance;
-- `Info.CD` is a blanket lock over every move at once.
local function movesetFolder(char)
    return char and char:FindFirstChild("Moveset") or nil
end

local function findMove(char, serviceName)
    local moveset = movesetFolder(char)
    if not moveset then return nil end
    for _, move in ipairs(moveset:GetChildren()) do
        if move:GetAttribute("Service") == serviceName then
            return move
        end
    end
    return nil
end

local function cooldownLeft(move)
    if not move then return math.huge end
    local readyAt = move:GetAttribute("ReadyAt")
    if not readyAt then return 0 end
    return math.max(0, readyAt - serverNow())
end

local function globallyLocked(char)
    local info = infoOf(char)
    return info ~= nil and info:GetAttribute("CD") and true or false
end

--// The timing table ---------------------------------------------------------
-- Two numbers per move, both measured, neither readable:
--
--   lead   how long between the announcement and the stun actually landing.
--          This is the reaction budget, and it is what auto block and auto
--          manji gate on.
--   dur    how long the stun lasted once it landed.
--
-- Attribution is "the most recent announcement from someone else, within
-- range, inside RecentWindow". That is a heuristic and it will mis-attribute
-- in a crowded fight. The sample count is shown in the UI so a number backed
-- by two samples is visibly not a number backed by forty.

local function timingKey(service, effect)
    return service .. '.' .. effect
end

local function timingFor(key)
    local entry = Intel.Timing[key]
    if not entry then
        entry = { n = 0, lead = 0, dur = 0, ragdoll = 0, last = 0 }
        Intel.Timing[key] = entry
    end
    return entry
end

local function blendInto(entry, field, value)
    local n = entry.n
    if n <= 1 then
        entry[field] = value
    else
        entry[field] = entry[field] + (value - entry[field]) / n
    end
end

local function recordSample(key, lead, duration, wasRagdoll)
    local entry = timingFor(key)
    entry.n = entry.n + 1
    blendInto(entry, 'lead', lead)
    blendInto(entry, 'dur', duration)
    blendInto(entry, 'ragdoll', wasRagdoll and 1 or 0)
    entry.last = tick()
    Intel.Samples = Intel.Samples + 1
end

-- Best guess at how much warning a move gives, or nil when it has never been
-- measured. Callers must treat nil as "unknown", never as zero.
local function predictedLead(key)
    local entry = Intel.Timing[key]
    if not entry or entry.n < 1 then return nil end
    return entry.lead, entry.n
end

local function predictedStun(key)
    local entry = Intel.Timing[key]
    if not entry or entry.n < 1 then return nil end
    return entry.dur, entry.n
end

--// Announcement feed --------------------------------------------------------

local feedSink = nil        -- set by the UI once it exists
local statusSink = nil

local function pushFeed(text, kind)
    table.insert(Intel.Feed, { text = text, kind = kind, at = tick() })
    while #Intel.Feed > Intel.FeedLimit do
        table.remove(Intel.Feed, 1)
    end
    if feedSink and IntelConfig.LogFeed then
        feedSink(text, kind)
    end
end

-- The Effects payload is (effectName, ...) and the controllers all treat the
-- first model in the varargs as the actor. Rather than hardcoding which
-- position that is for 226 different services, find it.
local function actorFrom(...)
    for index = 1, select('#', ...) do
        local value = select(index, ...)
        if typeof(value) == 'Instance' and value:IsA('Model') and value:FindFirstChild('HumanoidRootPart') then
            return value
        end
    end
    return nil
end

local function distanceTo(char)
    local mine = ownCharacter()
    if not mine or not char then return math.huge end
    local a = mine:FindFirstChild('HumanoidRootPart')
    local b = char:FindFirstChild('HumanoidRootPart')
    if not a or not b then return math.huge end
    return (a.Position - b.Position).Magnitude
end

local function noteAnnouncement(service, effect, actor)
    local now = tick()
    table.insert(Intel.Recent, {
        key = timingKey(service, effect),
        service = service,
        effect = effect,
        actor = actor,
        at = now,
        distance = distanceTo(actor),
    })
    -- Trim by age rather than count so a quiet minute doesn't keep stale
    -- events around to be attributed to a fresh stun.
    local cutoff = now - Intel.RecentWindow
    while Intel.Recent[1] and Intel.Recent[1].at < cutoff do
        table.remove(Intel.Recent, 1)
    end
end

-- The most recent thing that could plausibly have caused a hit on `victim`.
local function blameFor(victim, at)
    local best = nil
    for index = #Intel.Recent, 1, -1 do
        local event = Intel.Recent[index]
        if event.at <= at and at - event.at <= Intel.RecentWindow then
            if event.actor ~= victim and event.distance <= IntelConfig.Range then
                best = event
                break
            end
        end
    end
    return best
end

local hookedServices = {}

local function hookService(serviceFolder)
    if hookedServices[serviceFolder] then return end
    local re = serviceFolder:FindFirstChild('RE')
    local effects = re and re:FindFirstChild('Effects')
    if not effects or not effects:IsA('RemoteEvent') then
        -- Some services use UnreliableRemoteEvent for Effects; both fire
        -- OnClientEvent, so only the class check needs widening.
        if not (effects and effects:IsA('UnreliableRemoteEvent')) then
            return
        end
    end
    hookedServices[serviceFolder] = true
    Intel.Hooked = Intel.Hooked + 1

    local serviceName = serviceFolder.Name:gsub('Service$', '')
    effects.OnClientEvent:Connect(function(effectName, ...)
        if not IntelConfig.Enabled then return end
        if type(effectName) ~= 'string' then return end
        local actor = actorFrom(...)
        if not actor or isOwn(actor) then return end
        if IMPACT_EFFECTS[effectName] then return end

        local distance = distanceTo(actor)
        if distance > IntelConfig.Range then return end

        noteAnnouncement(serviceName, effectName, actor)

        local key = timingKey(serviceName, effectName)
        local lead, samples = predictedLead(key)
        local text
        if lead then
            text = ('%s  %s  %.0fst  ~%.2fs lead (n=%d)')
                :format(actor.Name, serviceName, distance, lead, samples)
        else
            text = ('%s  %s  %.0fst  lead unknown'):format(actor.Name, serviceName, distance)
        end
        pushFeed(text, lead and 'info' or nil)
    end)
end

local function hookAllServices()
    for _, folder in ipairs(Services:GetChildren()) do
        pcall(hookService, folder)
    end
    Services.ChildAdded:Connect(function(folder)
        task.wait(0.1)
        pcall(hookService, folder)
    end)
end

--// Measuring what we get hit by ---------------------------------------------
-- Watch Info on every character. When a Stun appears, blame the most recent
-- nearby announcement and start a clock; when it is destroyed, close the
-- sample. Watching everyone rather than only ourselves fills the table far
-- faster, at the cost of noisier attribution in a group fight.

local watchedInfo = setmetatable({}, { __mode = 'k' })

local function watchInfo(char)
    local info = infoOf(char)
    if not info or watchedInfo[info] then return end
    watchedInfo[info] = true

    info.ChildAdded:Connect(function(state)
        if not Intel.Learning then return end
        if state.Name ~= 'Stun' then return end
        local startedAt = tick()
        local blame = blameFor(char, startedAt)
        if not blame then return end
        local ragdolled = isRagdolled(char)
        -- Destroying rather than ChildRemoved: Debris destroys the instance,
        -- and Destroying fires for that while ChildRemoved would also fire if
        -- the whole character were being torn down.
        state.Destroying:Connect(function()
            local duration = tick() - startedAt
            -- A stun that outlives the attribution window is almost certainly
            -- a chain of several moves, not one long one.
            if duration > 12 then return end
            recordSample(blame.key, startedAt - blame.at, duration, ragdolled)
        end)
    end)
end

local function watchCharacters()
    local folder = charactersFolder()
    if not folder then
        workspace.ChildAdded:Connect(function(child)
            if child.Name == 'Characters' then
                task.wait(0.2)
                watchCharacters()
            end
        end)
        return
    end
    for _, char in ipairs(folder:GetChildren()) do
        pcall(watchInfo, char)
    end
    folder.ChildAdded:Connect(function(char)
        -- Info is parented in a moment after the model itself.
        for _ = 1, 20 do
            if infoOf(char) then break end
            task.wait(0.1)
        end
        pcall(watchInfo, char)
    end)
end

--// Counter automation -------------------------------------------------------
-- Both of these drive the game's own ToolController rather than firing remotes
-- by hand. Block() and UseTool() are exactly what a keypress calls, so what
-- reaches the server is shaped like a real input instead of a reconstruction
-- of one.

local ToolController = nil

local function toolController()
    if ToolController then return ToolController end
    local ok, controller = pcall(function()
        return Knit.GetController("ToolController")
    end)
    if ok and controller then
        ToolController = controller
    end
    return ToolController
end

local BlockDeactivated do
    local folder = Services:FindFirstChild("BlockService")
    local re = folder and folder:FindFirstChild("RE")
    BlockDeactivated = re and re:FindFirstChild("Deactivated") or nil
end

local ManjiConfig = {
    Enabled = false,
    -- How long the counter stays active once thrown. This is a COUNTER node's
    -- TIME field, which lives server-side for the built-in movesets, so it is
    -- a setting rather than a reading. Everything else on this panel is real.
    Window = 0.5,
    -- Below this the input would land after the hit does.
    Reaction = 0.08,
    Range = 60,
    AssumeLead = 0.35,
    UseUnmeasured = false,
    Attempts = 0,
    Skipped = 0,
    Last = 'idle',
}

local BlockConfig = {
    Enabled = false,
    -- Only block attacks arriving from inside this cone. The game breaks a
    -- block that is not facing the attack, and blocking a hit coming from
    -- behind is the tell that gives an auto block away, so both reasons point
    -- the same way.
    MaxAngle = 75,
    Hold = 0.45,
    Reaction = 0.06,
    LookAhead = 0.9,
    Range = 70,
    AssumeLead = 0.35,
    UseUnmeasured = true,
    Attempts = 0,
    Skipped = 0,
    Last = 'idle',
}

-- Called from the Heartbeat loop, so it repaints only on an actual change
-- rather than rewriting four labels sixty times a second.
local function setStatus(which, text)
    if which.Last == text then return end
    which.Last = text
    if statusSink then statusSink() end
end

-- The freshest announcement we could still do something about, plus how long
-- until it lands. Returns nil when nothing is pending or the timing is unknown
-- and the caller does not want to guess.
local function pendingThreat(cfg)
    local now = tick()
    for index = #Intel.Recent, 1, -1 do
        local event = Intel.Recent[index]
        local actor = event.actor
        if now - event.at > Intel.RecentWindow then
            -- Everything below this point in the list is older still.
            break
        end
        if actor and actor.Parent and not isOwn(actor) then
            local distance = distanceTo(actor)
            if distance <= cfg.Range then
                local lead, samples = predictedLead(event.key)
                local measured = lead ~= nil
                if not measured then
                    if not cfg.UseUnmeasured then
                        return nil, 'unmeasured: ' .. event.key
                    end
                    lead = cfg.AssumeLead
                    samples = 0
                end
                local impactAt = event.at + lead
                return {
                    event = event,
                    actor = actor,
                    distance = distance,
                    measured = measured,
                    samples = samples or 0,
                    timeLeft = impactAt - now,
                }
            end
        end
    end
    return nil, 'nothing incoming'
end

--// Auto manji kick ----------------------------------------------------------

local manjiBusyUntil = 0

local function manjiMove()
    local char = ownCharacter()
    if not char then return nil end
    local move = findMove(char, "ManjiKickService")
    if move then return move end
    -- Fall back to the display name in case the Service attribute is ever
    -- renamed; the move instance is what UseTool needs either way.
    local moveset = movesetFolder(char)
    return moveset and moveset:FindFirstChild("Manji Kick") or nil
end

local function fireMove(move)
    local controller = toolController()
    if controller then
        local ok = pcall(function()
            controller:UseTool(move, "Activated")
        end)
        if ok then return true end
        local key = move:GetAttribute("Key")
        if key then
            ok = pcall(function()
                controller:UseKey(key, "Activated")
            end)
            if ok then return true end
        end
    end
    -- Last resort: the raw remote, with the move instance the server expects.
    local folder = Services:FindFirstChild("ManjiKickService")
    local re = folder and folder:FindFirstChild("RE")
    local activated = re and re:FindFirstChild("Activated")
    if activated then
        local ok = pcall(function()
            activated:FireServer(move)
        end)
        return ok
    end
    return false
end

local function tryManji()
    if not ManjiConfig.Enabled then return end
    local now = tick()
    if now < manjiBusyUntil then return end

    local char = ownCharacter()
    local able, why = canAct(char)
    if not able then
        setStatus(ManjiConfig, why)
        return
    end
    if globallyLocked(char) then
        setStatus(ManjiConfig, 'global cooldown')
        return
    end

    local move = manjiMove()
    if not move then
        setStatus(ManjiConfig, 'no manji kick on this moveset')
        return
    end
    local left = cooldownLeft(move)
    if left > 0 then
        setStatus(ManjiConfig, ('cooldown %.1fs'):format(left))
        return
    end

    local threat, reason = pendingThreat(ManjiConfig)
    if not threat then
        setStatus(ManjiConfig, reason or 'nothing incoming')
        return
    end

    -- The waste test. A counter thrown too early expires before the hit
    -- arrives and eats its cooldown for nothing; thrown too late it does not
    -- come out in time at all. Only the band between the two is worth spending
    -- the move on.
    if threat.timeLeft < ManjiConfig.Reaction then
        ManjiConfig.Skipped = ManjiConfig.Skipped + 1
        setStatus(ManjiConfig, ('too late (%.2fs)'):format(threat.timeLeft))
        return
    end
    if threat.timeLeft > ManjiConfig.Window then
        ManjiConfig.Skipped = ManjiConfig.Skipped + 1
        setStatus(ManjiConfig, ('too early (%.2fs > %.2fs window)')
            :format(threat.timeLeft, ManjiConfig.Window))
        return
    end

    if fireMove(move) then
        ManjiConfig.Attempts = ManjiConfig.Attempts + 1
        manjiBusyUntil = now + 0.35
        setStatus(ManjiConfig, ('countered %s (%.2fs)')
            :format(threat.event.service, threat.timeLeft))
        pushFeed(('manji -> %s in %.2fs'):format(threat.event.service, threat.timeLeft), 'success')
    else
        setStatus(ManjiConfig, 'activation failed')
    end
end

--// Auto block ---------------------------------------------------------------

local blockHeldUntil = 0
local blockReleaseToken = 0

local function releaseBlock()
    if BlockDeactivated then
        pcall(function()
            BlockDeactivated:FireServer()
        end)
    end
    blockHeldUntil = 0
end

-- How far off our facing the attacker is, in degrees. The game breaks a block
-- that is not oriented into the attack, so this is both the "will it even
-- work" test and the "will this look like a 360 block" test.
local function angleToward(char, actor)
    local mine = char and char:FindFirstChild('HumanoidRootPart')
    local theirs = actor and actor:FindFirstChild('HumanoidRootPart')
    if not mine or not theirs then return 180 end
    local toward = (theirs.Position - mine.Position) * Vector3.new(1, 0, 1)
    if toward.Magnitude < 0.01 then return 0 end
    local look = mine.CFrame.LookVector * Vector3.new(1, 0, 1)
    if look.Magnitude < 0.01 then return 180 end
    local dot = math.clamp(look.Unit:Dot(toward.Unit), -1, 1)
    return math.deg(math.acos(dot))
end

local function tryBlock()
    if not BlockConfig.Enabled then return end
    local now = tick()
    if now < blockHeldUntil then return end

    local char = ownCharacter()
    local able, why = canAct(char)
    if not able then
        setStatus(BlockConfig, why)
        return
    end
    if hasState(char, 'NoBlock') then
        setStatus(BlockConfig, 'blocking disabled on us')
        return
    end
    if hasState(char, 'Block') then
        setStatus(BlockConfig, 'already blocking')
        return
    end

    local threat, reason = pendingThreat(BlockConfig)
    if not threat then
        setStatus(BlockConfig, reason or 'nothing incoming')
        return
    end

    if threat.timeLeft < BlockConfig.Reaction then
        BlockConfig.Skipped = BlockConfig.Skipped + 1
        setStatus(BlockConfig, ('too late (%.2fs)'):format(threat.timeLeft))
        return
    end
    if threat.timeLeft > BlockConfig.LookAhead then
        setStatus(BlockConfig, ('waiting (%.2fs out)'):format(threat.timeLeft))
        return
    end

    local angle = angleToward(char, threat.actor)
    if angle > BlockConfig.MaxAngle then
        BlockConfig.Skipped = BlockConfig.Skipped + 1
        setStatus(BlockConfig, ('%.0f deg off - not facing it'):format(angle))
        return
    end

    local controller = toolController()
    if not controller then
        setStatus(BlockConfig, 'no ToolController')
        return
    end
    local ok = pcall(function()
        controller:Block()
    end)
    if not ok then
        setStatus(BlockConfig, 'block call failed')
        return
    end

    BlockConfig.Attempts = BlockConfig.Attempts + 1
    blockHeldUntil = now + BlockConfig.Hold
    blockReleaseToken = blockReleaseToken + 1
    local token = blockReleaseToken
    task.delay(BlockConfig.Hold, function()
        -- A newer block may have taken over in the meantime; only the most
        -- recent hold is allowed to release.
        if token == blockReleaseToken then
            releaseBlock()
        end
    end)
    setStatus(BlockConfig, ('blocked %s at %.0f deg'):format(threat.event.service, angle))
    pushFeed(('block -> %s (%.0f deg, %.2fs)'):format(threat.event.service, angle, threat.timeLeft), 'success')
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if IntelConfig.Enabled then
            pcall(tryManji)
            pcall(tryBlock)
        end
    end
end)

