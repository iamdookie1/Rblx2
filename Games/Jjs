local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local Config = {
    Enabled = false,
    Chance = 100,
}


local BLACKFLASH_DELAY = 0.212
local VARIANT4_DELAY = 0.4

-- Black flash timing under lag.
--
-- The old version slept for a fixed 0.212s with task.delay and fired. Two
-- things break that when the connection is poor:
--
--   task.delay counts wall-clock seconds, but the swing it is trying to hit
--   is an animation. A frame hitch delays the animation without delaying the
--   timer, so the fire lands at the wrong point of a swing that has not got
--   there yet.
--
--   Even with perfect local timing, the remote still has to travel. The server
--   judges the window against when it *receives* the fire, so a 90ms ping puts
--   every attempt 90ms late no matter how well the client timed it.
--
-- So the trigger reads the animation's own clock instead of sleeping, and
-- fires early by the measured ping. What is left after that is whatever the
-- ping figure gets wrong, which is what the tuner below is for.
local FlashTune = {
    PingComp = true,
    AutoTune = true,
    -- Extra lead tried on top of ping compensation, in seconds. Kept small:
    -- this is correcting the error in a latency estimate, not the delay.
    Candidates = { -0.06, -0.04, -0.02, 0, 0.02, 0.04, 0.06 },
    Stats = {},          -- offset -> { n, hit }
    Current = 0,
    Attempts = 0,
    Hits = 0,
    Pending = nil,
    MinSamples = 4,
    ExploreChance = 0.25,
}

local function flashStat(offset)
    local entry = FlashTune.Stats[offset]
    if not entry then
        entry = { n = 0, hit = 0 }
        FlashTune.Stats[offset] = entry
    end
    return entry
end

-- Mostly use the best offset seen so far, but keep sampling the others: a
-- candidate that lost its first two coin flips would otherwise never be tried
-- again, and ping drifts over a session anyway.
local function pickOffset()
    if not FlashTune.AutoTune then
        return 0
    end
    if math.random() < FlashTune.ExploreChance then
        return FlashTune.Candidates[math.random(1, #FlashTune.Candidates)]
    end
    local best, bestRate = nil, -1
    for _, offset in ipairs(FlashTune.Candidates) do
        local entry = FlashTune.Stats[offset]
        if entry and entry.n >= FlashTune.MinSamples then
            local rate = entry.hit / entry.n
            if rate > bestRate then
                best, bestRate = offset, rate
            end
        end
    end
    return best or 0
end

local function currentPing()
    if not FlashTune.PingComp then return 0 end
    local ok, ping = pcall(function()
        return LocalPlayer:GetNetworkPing()
    end)
    if ok and type(ping) == 'number' and ping >= 0 then
        -- GetNetworkPing reports seconds. Capped so a spike cannot pull the
        -- fire back before the swing has started.
        return math.clamp(ping, 0, BLACKFLASH_DELAY * 0.75)
    end
    return 0
end

local Services = ReplicatedStorage.Knit.Knit.Services
local Activated = Services.DivergentFistService.RE.Activated
local RightActivated = Services.ItadoriService.RE.RightActivated
local DashRemote = Services.MovementService.RE.Dash


local Knit = require(ReplicatedStorage.Knit.Knit)

local DashConfig = {
    Enabled = false,
    Cooldown = 0.5,
}

-- Dash manipulation.
--
-- MovementController:Dash builds the movement itself, on the client, out of a
-- BodyVelocity named MovementForce parented into the Torso for 0.4 seconds.
-- Its speed is `direction * (200 * multiplier)`, and the multiplier is read
-- straight off `character.Info.DashMultiplier` - a Value instance the game
-- looks up every single dash:
--
--     local v41 = Info:FindFirstChild("DashMultiplier")
--     local v42 = v41 and v41.Value or 1
--     local v43 = DIRECTIONS[dir] * (200 * v42)
--
-- So there is nothing to hook. Putting our own DashMultiplier in Info makes
-- the game's own dash code go further, using its own animation, dust trail and
-- decay curve. We own our character's physics, so the movement replicates.
--
-- Front is the exception: DashRequest routes it to UseSetService("Chase"),
-- a server-side lunge that never touches this code and cannot be scaled from
-- here. What it can do instead is take the movement-dash path - the direction
-- table has a Front entry and the game ships a DashFront animation - which is
-- a real front dash rather than a chase, and that one does scale.
local DashMod = {
    Enabled = false,
    Multiplier = 1.6,
    FrontAsDash = false,
    FrontMultiplier = 1.6,
    Applied = nil,
}

local function dashMultiplierValue(character)
    local info = character and character:FindFirstChild("Info")
    if not info then return nil end

    local existing = info:FindFirstChild("DashMultiplier")
    if existing then
        -- Some movesets ship their own. Remember what it was so turning this
        -- off gives that moveset its dash back rather than leaving ours on it.
        if DashMod.Applied ~= existing then
            DashMod.Applied = existing
            DashMod.Borrowed = true
            DashMod.Original = existing.Value
        end
        return existing
    end

    if not DashMod.Enabled then return nil end
    local value = Instance.new("NumberValue")
    value.Name = "DashMultiplier"
    value.Value = 1
    value.Parent = info
    DashMod.Applied = value
    DashMod.Borrowed = false
    DashMod.Original = nil
    return value
end

-- Created on the first dash and then left in place, tracking the slider, until
-- the feature is switched off. Nothing else in the game reads DashMultiplier,
-- so there is no reason to keep adding and removing it around every dash.
local function applyDashMultiplier(character, multiplier)
    local value = dashMultiplierValue(character)
    if value then
        value.Value = multiplier
    end
end

local function clearDashMultiplier()
    local value = DashMod.Applied
    if not value then return end
    pcall(function()
        if DashMod.Borrowed then
            value.Value = DashMod.Original or 1
        else
            value:Destroy()
        end
    end)
    DashMod.Applied = nil
    DashMod.Borrowed = false
    DashMod.Original = nil
end

local AnimVariants = ReplicatedStorage.Animations.Itadori.Variants

local DIVERGENT_IDS = {
    [AnimVariants.DivergentFist1.AnimationId] = 1,
    [AnimVariants.DivergentFist2.AnimationId] = 2,
    [AnimVariants.DivergentFist3.AnimationId] = 3,
    [AnimVariants.DivergentFist4.AnimationId] = 4,
}

-- Dash cooldown changer: hooks MovementController.DashRequest so a custom
-- cooldown applies to Back/Left/Right dashes. Front dash is a separate
-- "chase" ability (routed to the original handler untouched) since it
-- doesn't go through the same movement-dash cooldown or remote at all.
local LastCustomDash = 0
local OriginalDashRequest = nil

local function getMovementController()
    local ok, controller = pcall(function()
        return Knit.GetController("MovementController")
    end)
    if ok then return controller end
    return nil
end

local function getDashDirection(humanoid, hrp)
    local camLook = workspace.CurrentCamera.CFrame.LookVector
    local flat = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camLook.X, 0, camLook.Z))
    local forward = math.round(humanoid.MoveDirection:Dot(flat.LookVector))
    local right = math.round(humanoid.MoveDirection:Dot(flat.RightVector))
    if forward == 1 then return "Front" end
    if forward == -1 then return "Back" end
    if right == 1 then return "Right" end
    if right == -1 then return "Left" end
    return "Front"
end

local function hookDashRequest()
    if OriginalDashRequest then return true end

    local Controller = getMovementController()
    if not Controller then return false end

    OriginalDashRequest = Controller.DashRequest

    Controller.DashRequest = function(self, ...)
        if not DashConfig.Enabled and not DashMod.Enabled then
            return OriginalDashRequest(self, ...)
        end

        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local info = character and character:FindFirstChild("Info")
        if not (character and hrp and humanoid and info) then
            return OriginalDashRequest(self, ...)
        end

        -- Unconditional knockback/burst escape dash: never gated by cooldown.
        if info:FindFirstChild("Knockback")
            or (character:GetAttribute("Burst") and not info:GetAttribute("Burst"))
            or (info:FindFirstChild("ForceEsc") and info.ForceEsc.Value) then
            return OriginalDashRequest(self, ...)
        end

        local direction = getDashDirection(humanoid, hrp)
        local rerouteFront = DashMod.Enabled and DashMod.FrontAsDash

        -- With only the multiplier on, the game keeps its own cooldown and its
        -- own dash call; all we do is set the value it is about to read.
        if not DashConfig.Enabled then
            if DashMod.Enabled and not (direction == "Front" and not rerouteFront) then
                applyDashMultiplier(character,
                    direction == "Front" and DashMod.FrontMultiplier or DashMod.Multiplier)
            end
            if direction == "Front" and rerouteFront then
                if info:FindFirstChild("NoDash") then return end
                if info:FindFirstChild("Stun") then return end
                if character:GetAttribute("Ragdoll") > 0 then return end
                DashRemote:FireServer(direction)
                self:Dash(LocalPlayer, character, direction)
                return
            end
            return OriginalDashRequest(self, ...)
        end

        if direction == "Front" and not rerouteFront then
            return OriginalDashRequest(self, ...)
        end

        -- Preserve the game's own movement-state guards; only the cooldown changes.
        if info:FindFirstChild("Block") then return end
        if info:FindFirstChild("Stun") then return end
        if character:GetAttribute("Ragdoll") > 0 then return end
        local inSkill = info:FindFirstChild("InSkill")
        if inSkill and inSkill.Value == false then return end
        if info:FindFirstChild("NoDash") then return end
        local noSprint = info:FindFirstChild("NoSprint")
        if noSprint and noSprint.Value == false then return end

        if tick() - LastCustomDash < DashConfig.Cooldown then return end
        LastCustomDash = tick()

        if DashMod.Enabled then
            applyDashMultiplier(character,
                direction == "Front" and DashMod.FrontMultiplier or DashMod.Multiplier)
        end

        DashRemote:FireServer(direction)
        self:Dash(LocalPlayer, character, direction)
    end

    return true
end

local function getCharFolder()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then return nil end
    return chars:FindFirstChild(LocalPlayer.Name)
end

local function getDivergentFistArg()
    local folder = getCharFolder()
    if not folder then return nil end
    local moveset = folder:FindFirstChild("Moveset")
    if not moveset then return nil end
    return moveset:FindFirstChild("Divergent Fist")
end

-- Fires when the animation itself reaches `at`, rather than when a timer says
-- that much time has passed. A dropped frame moves both together.
local function atAnimationTime(track, at, run)
    local connection
    local started = tick()
    connection = RunService.Heartbeat:Connect(function()
        local ok, isPlaying, timePosition = pcall(function()
            return track.IsPlaying, track.TimePosition
        end)
        if not ok or not isPlaying then
            connection:Disconnect()
            return
        end
        if timePosition >= at then
            connection:Disconnect()
            run()
        elseif tick() - started > 3 then
            -- The track should never run this long; never leak the connection.
            connection:Disconnect()
        end
    end)
    return connection
end

local function hookTrack(track, id)
    local variant = DIVERGENT_IDS[id]
    if not variant then return end

    if variant == 4 then
        atAnimationTime(track, VARIANT4_DELAY, function()
            if not Config.Enabled then return end
            RightActivated:FireServer()
        end)
        return
    end

    local shouldFire = math.random(1, 100) <= Config.Chance
    if not shouldFire then return end

    local offset = pickOffset()
    local lead = currentPing() + offset
    -- Clamped so a large lead cannot ask for a negative animation time, which
    -- would fire on the very first frame of the swing.
    local at = math.clamp(BLACKFLASH_DELAY - lead, 0.02, BLACKFLASH_DELAY)

    atAnimationTime(track, at, function()
        if not Config.Enabled then return end
        local arg = getDivergentFistArg()
        if not arg then return end
        Activated:FireServer(arg)

        FlashTune.Current = offset
        FlashTune.Attempts = FlashTune.Attempts + 1
        -- Resolved by the ItadoriService broadcast: BlackFlashHit means the
        -- window was hit, a plain Hit means we connected without it, and
        -- nothing at all means the punch missed and says nothing about timing.
        local attempt = { offset = offset, at = tick(), done = false }
        FlashTune.Pending = attempt
        task.delay(1.2, function()
            if not attempt.done then
                attempt.done = true
                FlashTune.Pending = nil
            end
        end)
    end)
end

-- Its own listener rather than a branch inside the generic Effects hook: the
-- black flash has nothing to do with the intel feed and should tune itself
-- whether or not that is switched on.
do
    local itadoriRE = Services:FindFirstChild("ItadoriService")
    itadoriRE = itadoriRE and itadoriRE:FindFirstChild("RE")
    local effects = itadoriRE and itadoriRE:FindFirstChild("Effects")
    if effects then
        effects.OnClientEvent:Connect(function(effectName, attacker)
            if not FlashTune.AutoTune then return end
            local attempt = FlashTune.Pending
            if not attempt or attempt.done then return end
            if typeof(attacker) ~= 'Instance' then return end
            if attacker.Name ~= LocalPlayer.Name and attacker ~= LocalPlayer.Character then
                return
            end
            -- BlackFlashHit means the window was hit. A plain Hit means we
            -- connected without it, which is the case that says the timing was
            -- off. A whiff produces neither and is left out of the tally,
            -- since it says nothing about when we fired.
            if effectName == 'BlackFlashHit' then
                attempt.done = true
                FlashTune.Pending = nil
                local entry = flashStat(attempt.offset)
                entry.n = entry.n + 1
                entry.hit = entry.hit + 1
                FlashTune.Hits = FlashTune.Hits + 1
            elseif effectName == 'Hit' then
                attempt.done = true
                FlashTune.Pending = nil
                local entry = flashStat(attempt.offset)
                entry.n = entry.n + 1
            end
        end)
    end
end

local function connectHumanoid(hum)
    hum.AnimationPlayed:Connect(function(track)
        if not Config.Enabled then return end
        local id = track.Animation and track.Animation.AnimationId
        if id then
            hookTrack(track, id)
        end
    end)
end

local function onCharacterAdded(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
        or char:WaitForChild("Humanoid", 5)
    if hum then
        connectHumanoid(hum)
    end
end

local function watchForCharacter()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then
        workspace.ChildAdded:Connect(function(child)
            if child.Name == "Characters" then
                local playerFolder = child:WaitForChild(LocalPlayer.Name, 10)
                if playerFolder then
                    onCharacterAdded(playerFolder)
                    playerFolder.ChildAdded:Connect(function(child2)
                        if child2:IsA("Humanoid") then
                            connectHumanoid(child2)
                        end
                    end)
                end
            end
        end)
        return
    end

    local playerFolder = chars:FindFirstChild(LocalPlayer.Name)
    if playerFolder then
        onCharacterAdded(playerFolder)
        playerFolder.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then
                connectHumanoid(child)
            end
        end)
    else
        chars.ChildAdded:Connect(function(child)
            if child.Name == LocalPlayer.Name then
                onCharacterAdded(child)
                child.ChildAdded:Connect(function(child2)
                    if child2:IsA("Humanoid") then
                        connectHumanoid(child2)
                    end
                end)
            end
        end)
    end
end

watchForCharacter()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    watchForCharacter()
end)

task.spawn(function()
    for _ = 1, 20 do
        if hookDashRequest() then return end
        task.wait(0.5)
    end
end)


--// Combat intel ------------------------------------------------------------
-- Everything below reads state the server already replicates. Nothing here is
-- a guess about server internals except where it says so.
--
-- Three facts make it work, all confirmed against the dump:
--
--   1. Every move is a Knit service with an `RE.Effects` RemoteEvent that the
--      server broadcasts to *all* clients as (effectName, ...). The controllers
--      use it purely for VFX, and the first argument is the acting character.
--      That is the only announcement of "someone started doing something" that
--      reaches us, and it reaches us for everyone on the server.
--
--   2. Character state is instances in `character.Info` - Stun, Block, IFrame,
--      InSkill, NoBlock, Wakeup - created by the server and deleted by a
--      server-side Debris timer. So we can see that someone is stunned and
--      when it ends, but the *length* never crosses the wire. It has to be
--      measured.
--
--   3. Each move under `character.Moveset` carries a `ReadyAt` attribute, an
--      absolute time compared against workspace:GetServerTimeNow(). Cooldowns
--      are readable, exactly, for our own moves.
--
-- What is NOT readable, and no amount of client code changes this: whether a
-- given attack is blockable, whether it is 360-blockable, and what attack type
-- it is (which is what decides whether a counter catches it). Those live in
-- server scripts. The timing table below is the workaround - it does not learn
-- *whether* a move can be blocked, it learns *how long you have to react*, and
-- everything defensive here gates on that instead.

-- Set once ManjiConfig exists further down; only used as a fallback when a
-- counter goes out against a move whose lead has never been measured.
local ManjiConfig_AssumeLead = 0.35

local Intel = {
    -- Rolling feed of move announcements, newest last.
    Feed = {},
    FeedLimit = 60,
    -- key -> { n, lead, dur, ragdoll } running means, keyed "Service.Effect".
    Timing = {},
    -- Events seen recently, used to attribute a stun to whatever caused it.
    Recent = {},
    RecentWindow = 2.5,
    Learning = true,
    Samples = 0,
    Hooked = 0,
}

local IntelConfig = {
    Enabled = false,
    Range = 90,
    LogFeed = true,
}

-- Effects that fire on impact rather than on startup. Reacting to them is
-- pointless - the hit has already landed - but the bigger reason to drop them
-- is blame: the timing table credits a stun to the most recent announcement,
-- so an impact event arriving at the same moment as the stun would take the
-- credit from the startup that actually gave warning, and the move would learn
-- a lead of roughly zero forever after.
--
-- Being slightly over-inclusive here is the safe direction. Filtering a real
-- startup costs one move's reactability; letting one impact event through
-- corrupts that move's timing permanently.
local IMPACT_EFFECTS = {
    Hurt = true, Impact = true, Land = true, Explode = true, Explosion = true,
    Blocked = true, Kill = true, Death = true, End = true, Finish = true,
    Cancel = true, Stop = true, Deactivate = true, Slam = true, Burst = true,
    TrueRagdoll = true, Shatter = true, Grab = true, Crush = true,
    -- Voice lines, not attacks.
    Chat = true, Chat2 = true, Voice = true, Emote = true,
}

-- Named variants are far too many to list: across the dump there is Hit, Hit2,
-- Hit3, ChaseHit, FinalHit, BlackFlashHit, AerialHit, DismantleHit, CleaveHit,
-- ThrowableHit and more. Every one of them is impact-time, so match the shape.
local function is_impact_effect(name)
    if IMPACT_EFFECTS[name] then
        return true
    end
    return string.find(name, 'Hit', 1, true) ~= nil
end

local function serverNow()
    local ok, value = pcall(function()
        return workspace:GetServerTimeNow()
    end)
    if ok and type(value) == 'number' then
        return value
    end
    return tick()
end

local function charactersFolder()
    return workspace:FindFirstChild("Characters")
end

local function ownCharacter()
    local folder = charactersFolder()
    local mine = folder and folder:FindFirstChild(LocalPlayer.Name)
    if mine and mine:FindFirstChild("HumanoidRootPart") then
        return mine
    end
    -- The game keeps a copy under Player.Character too, and which one is live
    -- depends on how far into a respawn we are.
    local fallback = LocalPlayer.Character
    if fallback and fallback:FindFirstChild("HumanoidRootPart") then
        return fallback
    end
    return nil
end

local function isOwn(model)
    if not model then return false end
    return model.Name == LocalPlayer.Name or model == LocalPlayer.Character
end

-- State reads. All of these work on any character, not just ours.

local function positionOf(char)
    local hrp = char and char:FindFirstChild('HumanoidRootPart')
    return hrp and hrp.Position or nil
end

local function infoOf(char)
    return char and char:FindFirstChild("Info") or nil
end

local function hasState(char, name)
    local info = infoOf(char)
    return info ~= nil and info:FindFirstChild(name) ~= nil
end

local function isRagdolled(char)
    if not char then return false end
    return (char:GetAttribute("Ragdoll") or 0) > 0
end

-- The one question that decides whether any of the automation may act, copied
-- from the game's own gate in DashRequest rather than invented:
--
--     if Info:FindFirstChild("Block") then return end
--     if Info:FindFirstChild("Stun") then return end
--     if char:GetAttribute("Ragdoll") > 0 then return end
--     local v132 = Info:FindFirstChild("InSkill")
--     if v132 and v132.Value == false then return end
--
-- Note the difference in how InSkill is treated. Block, Stun and Ragdoll are
-- presence checks, but InSkill only locks you out when its Value is false -
-- present-and-true means "in a skill and still allowed to act". Testing it by
-- presence, which is what this used to do, refused to block or counter through
-- any skill at all and was stricter than the game itself.
local function valueLocked(char, name)
    local info = infoOf(char)
    local state = info and info:FindFirstChild(name)
    return state ~= nil and state.Value == false
end

local function canAct(char)
    if not char then return false, 'no character' end
    if char:GetAttribute("Dead") then return false, 'dead' end
    if isRagdolled(char) then return false, 'ragdolled' end
    if hasState(char, 'Stun') then return false, 'stunned' end
    if valueLocked(char, 'InSkill') then return false, 'locked in a skill' end
    return true, 'ready'
end

local function evadeMeter(char)
    if not char then return 0 end
    return char:GetAttribute("Evade") or 0
end

-- The game treats "can burst" as the character attribute being set while the
-- Info-folder one is not - the second is the spent/cooldown marker.
local function canBurst(char)
    if not char then return false end
    local info = infoOf(char)
    return (char:GetAttribute("Burst") and true or false)
        and not (info and info:GetAttribute("Burst"))
end

local function describeState(char)
    if not char then return 'none' end
    if char:GetAttribute('Dead') then return 'dead' end
    if isRagdolled(char) then return 'ragdolled' end
    if hasState(char, 'Stun') then return 'stunned' end
    if hasState(char, 'IFrame') then return 'i-frames' end
    if hasState(char, 'Block') then return 'blocking' end
    if hasState(char, 'InSkill') then return 'in a skill' end
    return 'free'
end

-- Cooldowns. `ReadyAt` is an absolute server timestamp on the move instance;
-- `Info.CD` is a blanket lock over every move at once.
local function movesetFolder(char)
    return char and char:FindFirstChild("Moveset") or nil
end

local function findMove(char, serviceName)
    local moveset = movesetFolder(char)
    if not moveset then return nil end
    for _, move in ipairs(moveset:GetChildren()) do
        if move:GetAttribute("Service") == serviceName then
            return move
        end
    end
    return nil
end

local function cooldownLeft(move)
    if not move then return math.huge end
    local readyAt = move:GetAttribute("ReadyAt")
    if not readyAt then return 0 end
    return math.max(0, readyAt - serverNow())
end

local function globallyLocked(char)
    local info = infoOf(char)
    return info ~= nil and info:GetAttribute("CD") and true or false
end

--// The timing table ---------------------------------------------------------
-- Two numbers per move, both measured, neither readable:
--
--   lead   how long between the announcement and the stun actually landing.
--          This is the reaction budget, and it is what auto block and auto
--          manji gate on.
--   dur    how long the stun lasted once it landed.
--
-- Attribution is "the most recent announcement from someone else, within
-- range, inside RecentWindow". That is a heuristic and it will mis-attribute
-- in a crowded fight. The sample count is shown in the UI so a number backed
-- by two samples is visibly not a number backed by forty.

local function timingKey(service, effect)
    return service .. '.' .. effect
end

local REACH_SAMPLES = 24

local function timingFor(key)
    local entry = Intel.Timing[key]
    if not entry then
        entry = { n = 0, lead = 0, dur = 0, ragdoll = 0, dists = {}, last = 0 }
        Intel.Timing[key] = entry
    end
    return entry
end

local function blendInto(entry, field, value)
    local n = entry.n
    if n <= 1 then
        entry[field] = value
    else
        entry[field] = entry[field] + (value - entry[field]) / n
    end
end

local function recordSample(key, lead, duration, wasRagdoll, distance)
    local entry = timingFor(key)
    entry.n = entry.n + 1
    blendInto(entry, 'lead', lead)
    blendInto(entry, 'dur', duration)
    blendInto(entry, 'ragdoll', wasRagdoll and 1 or 0)
    if distance and distance < 1e6 then
        table.insert(entry.dists, distance)
        while #entry.dists > REACH_SAMPLES do
            table.remove(entry.dists, 1)
        end
    end
    entry.last = tick()
    Intel.Samples = Intel.Samples + 1
end

-- Best guess at how much warning a move gives, or nil when it has never been
-- measured. Callers must treat nil as "unknown", never as zero.
local function predictedLead(key)
    local entry = Intel.Timing[key]
    if not entry or entry.n < 1 then return nil end
    return entry.lead, entry.n
end

local function predictedStun(key)
    local entry = Intel.Timing[key]
    if not entry or entry.n < 1 then return nil end
    return entry.dur, entry.n
end

-- How far this move has been seen to reach.
--
-- This used to be the single furthest distance ever recorded, which was wrong
-- in the worst way: attribution is a heuristic, so one mis-blamed sample set
-- the reach forever and nothing could bring it back down. Basic attacks fire
-- constantly and so win attribution races constantly, which is exactly why
-- they were the ones that ended up looking like they reached across the map.
--
-- Second-largest instead, and only once there are enough samples for a
-- second-largest to mean anything. One bad blame no longer decides anything:
-- it takes two independent hits from that far out.
local REACH_MIN_SAMPLES = 4
-- learnedReach feeds the counters' reach check, which feeds back into what
-- blameFor() is willing to attribute next time - each accepted sample can
-- raise the ceiling for the next one by REACH_MARGIN. With no ceiling of its
-- own that compounds: 25% growth per generation reaches the thousands within
-- a few dozen stuns and keeps going from there, all inside one play session.
-- This is the actual fix for that - not a bigger BLAME_DEFAULT_REACH or a
-- smarter blame heuristic, just a wall the ratchet cannot climb past no
-- matter how many bad generations it already went through. Ranged moves
-- do not need this system to reach far: they are tracked by real position
-- now (see Projectiles above), so this only ever needs to cover melee.
local REACH_HARD_CAP = 250

local function learnedReach(key)
    local entry = Intel.Timing[key]
    if not entry or #entry.dists < REACH_MIN_SAMPLES then return nil end
    local top, second = -1, -1
    for _, d in ipairs(entry.dists) do
        if d > top then
            top, second = d, top
        elseif d > second then
            second = d
        end
    end
    if second <= 0 then return nil end
    return math.min(second, REACH_HARD_CAP)
end


--// Learning from outcomes ---------------------------------------------------
-- The timing table above learns *when* a move lands. This learns whether doing
-- something about it actually worked, which is the part that otherwise has to
-- be configured by hand.
--
-- Two outcome signals exist, both broadcast to every client:
--
--   BlockService.RE.Effects (character, wasPerfect)
--       Fires when a block actually absorbs a hit - the game uses it to play
--       the block clink, or the "Perfect" sting on a parry. So if we were
--       blocking and this names us, the attack was blockable from where we
--       stood. If we were blocking and got stunned with no such event, it was
--       not - either genuinely unblockable, or it broke through our guard.
--
--   ManjiKickService.RE.Effects "Hit" (attacker, victim)
--       Fires when the counter's kick connects, and names both sides, so a
--       Hit naming us as attacker is an unambiguous "the counter caught
--       something". No Hit inside the follow-up window means the throw was
--       wasted.
--
-- Neither tells us whether a move is blockable in the abstract - that lives in
-- a server script and always will. What they give is a record of what happened
-- the last N times we tried, per move, which is the thing worth acting on.

-- Auto block and auto manji, filled in under "Counter automation" further
-- down. Declared this early because the announcement hook and the throw
-- tracking below feed it.
local Counter = {}

local Outcomes = {
    -- key -> { blocked, pierced, countered, whiffed }
    Moves = {},
    -- Manji throws recorded as { timeLeft = , hit = }, used to find the window.
    Throws = {},
    ThrowLimit = 40,
    Enabled = true,
}

local function outcomeFor(key)
    local entry = Outcomes.Moves[key]
    if not entry then
        entry = { blocked = 0, pierced = 0, countered = 0, whiffed = 0 }
        Outcomes.Moves[key] = entry
    end
    return entry
end

-- How often blocking this move has actually worked. nil until it has been
-- tried, so callers can tell "never tested" from "tested and it fails".
local function blockability(key)
    local entry = Outcomes.Moves[key]
    if not entry then return nil, 0 end
    local tried = entry.blocked + entry.pierced
    if tried == 0 then return nil, 0 end
    return entry.blocked / tried, tried
end

-- One verdict, used by the automation and by everything that displays it, so
-- the panel can never describe a move differently from how the script treats
-- it. Thresholds live here rather than being restated at each call site.
local BLOCK_MIN_SAMPLES = 3
local BLOCK_FAIL_BELOW = 0.34
local BLOCK_PASS_ABOVE = 0.67

local function blockVerdict(key)
    local rate, tried = blockability(key)
    if not rate or tried < BLOCK_MIN_SAMPLES then
        return 'unknown', rate, tried or 0
    end
    if rate < BLOCK_FAIL_BELOW then
        return 'unblockable', rate, tried
    end
    if rate >= BLOCK_PASS_ABOVE then
        return 'blockable', rate, tried
    end
    return 'mixed', rate, tried
end

-- The measured counter window: how long the counter stays up once it reaches
-- the server. A throw that caught something with the hit still `timeLeft` out
-- here, sent with a round trip of `rtt`, reached the server rtt before that
-- hit did - so the window is at least timeLeft - rtt. The widest of those is
-- the estimate.
--
-- This used to be 90% of the widest raw timeLeft, which only ever shrank: a
-- few catches of hits already nearly on top of us pulled it under the
-- reaction floor, and from then on every threat was "too early" forever. The
-- round trip is taken off now, and the estimate is held between a floor and
-- a ceiling so no run of odd samples can switch the counter off.
local MIN_THROWS_FOR_WINDOW = 4

local function learnedWindow()
    local hits, misses, widest = 0, 0, 0
    for _, throw in ipairs(Outcomes.Throws) do
        if throw.hit then
            hits = hits + 1
            widest = math.max(widest, throw.timeLeft - (throw.rtt or 0))
        else
            misses = misses + 1
        end
    end
    if hits < MIN_THROWS_FOR_WINDOW then
        return nil, hits, misses
    end
    return math.clamp(widest, 0.2, 1.5), hits, misses
end

local function recordThrow(timeLeft, rtt)
    table.insert(Outcomes.Throws, { timeLeft = timeLeft, rtt = rtt, hit = false, at = tick() })
    while #Outcomes.Throws > Outcomes.ThrowLimit do
        table.remove(Outcomes.Throws, 1)
    end
    return Outcomes.Throws[#Outcomes.Throws]
end

--// Announcement feed --------------------------------------------------------

local feedSink = nil        -- set by the UI once it exists
local statusSink = nil

-- The M1 loop fires every 0.025s while the button is held, and a chain lands
-- several swings a second. Detection wants every one of them; the log does
-- not, so repeats of the same move by the same player collapse.
local lastLogged = {}
local FEED_REPEAT_GAP = 0.45

local function shouldLog(actor, key)
    local stamp = tostring(actor) .. '|' .. key
    local now = tick()
    local previous = lastLogged[stamp]
    if previous and now - previous < FEED_REPEAT_GAP then
        return false
    end
    lastLogged[stamp] = now
    return true
end

local function pushFeed(text, kind)
    table.insert(Intel.Feed, { text = text, kind = kind, at = tick() })
    while #Intel.Feed > Intel.FeedLimit do
        table.remove(Intel.Feed, 1)
    end
    if feedSink and IntelConfig.LogFeed then
        feedSink(text, kind)
    end
end

-- The Effects payload is (effectName, ...) and the controllers all treat the
-- first model in the varargs as the actor. Rather than hardcoding which
-- position that is for 226 different services, find it.
-- Swing2 is fired as (character, comboIndex, "Up"/"Down"), so an M1 chain
-- carries which hit of the string it is on. Worth surfacing: hit four is when
-- the finisher or launch comes.
local function comboIndexFrom(...)
    for index = 1, select('#', ...) do
        local value = select(index, ...)
        if type(value) == 'number' and value >= 1 and value <= 8 then
            return math.floor(value)
        end
    end
    return nil
end

local function actorFrom(...)
    for index = 1, select('#', ...) do
        local value = select(index, ...)
        if typeof(value) == 'Instance' and value:IsA('Model') and value:FindFirstChild('HumanoidRootPart') then
            return value
        end
    end
    return nil
end

local function distanceTo(char)
    local mine = ownCharacter()
    if not mine or not char then return math.huge end
    local a = mine:FindFirstChild('HumanoidRootPart')
    local b = char:FindFirstChild('HumanoidRootPart')
    if not a or not b then return math.huge end
    return (a.Position - b.Position).Magnitude
end

-- `mine` marks our own moves. They are still recorded, because attributing a
-- stun needs to know what caused it and half the stuns worth timing are ones
-- we inflicted - without them the countdown could never work on someone we
-- just hit. Everything defensive filters them back out.
local function noteAnnouncement(service, effect, actor, mine)
    local now = tick()
    table.insert(Intel.Recent, {
        key = timingKey(service, effect),
        service = service,
        effect = effect,
        actor = actor,
        mine = mine and true or false,
        at = now,
        -- Where the attacker stood when they announced. Distance then becomes
        -- a question about a specific victim rather than always about us,
        -- which is what lets somebody else's fight teach us anything.
        origin = positionOf(actor),
        distance = distanceTo(actor),
    })
    -- Trim by age rather than count so a quiet minute doesn't keep stale
    -- events around to be attributed to a fresh stun.
    local cutoff = now - Intel.RecentWindow
    while Intel.Recent[1] and Intel.Recent[1].at < cutoff do
        table.remove(Intel.Recent, 1)
    end
end

-- Which announcement caused this hit.
--
-- Taking the most recent one inside a 2.5s window was far too crude. Basic
-- attacks fire several times a second, so whatever else was happening, an M1
-- was almost always the newest thing in the list - and it collected the blame
-- for hits it had nothing to do with. Every wrong blame then poisoned that
-- move's learned lead, stun and reach.
--
-- Three things narrow it down, none of which need to know what the move is:
--
--   Time. Nothing older than BLAME_WINDOW is considered. Kept generous enough
--   for a slow wind-up to still be learnable - tightening this was tempting
--   but it throws away the slow moves along with the noise, and the other two
--   filters are the ones doing the real work.
--
--   Distance, checked against the move's own history rather than a blanket
--   number. A move known to land at six studs did not cause a hit from forty.
--   Until it has a history, a deliberately tight default applies - assume
--   short and let evidence extend it, never the other way round.
--
--   Fit. A move with a known lead of 0.22s explains a 0.21s gap far better
--   than it explains a 1.4s one. Candidates are scored on how well the
--   observed gap matches what that move has done before, and the best fit
--   wins rather than the newest.
local BLAME_WINDOW = 1.6
local BLAME_DEFAULT_REACH = 28
local REACH_MARGIN = 1.25

local function blameFor(victim, at)
    local best, bestScore, bestReach = nil, -math.huge, nil
    local target = positionOf(victim)
    for index = #Intel.Recent, 1, -1 do
        local event = Intel.Recent[index]
        local gap = at - event.at
        if gap > BLAME_WINDOW then
            break
        end
        if gap >= 0 and event.actor and event.actor ~= victim and event.actor.Parent then
            -- Measured from where the attacker stood to whoever got hit. Using
            -- our own distance would make every judgement about somebody
            -- else's fight meaningless, and those are most of the samples.
            local reachedFor = math.huge
            if event.origin and target then
                reachedFor = (event.origin - target).Magnitude
            end
            local reach = learnedReach(event.key)
            local limit = reach and (reach * REACH_MARGIN) or BLAME_DEFAULT_REACH
            if reachedFor <= limit then
                -- Recency and closeness break ties; fit dominates when known.
                local score = -gap * 0.5 - reachedFor / 200
                local lead = predictedLead(event.key)
                if lead then
                    score = score + 2 - math.min(2, math.abs(gap - lead) / 0.15)
                end
                if score > bestScore then
                    best, bestScore, bestReach = event, score, reachedFor
                end
            end
        end
    end
    return best, bestReach
end
-- A distance-blind fallback pass used to live here, meant to let a move
-- whose true reach exceeds BLAME_DEFAULT_REACH earn its first sample instead
-- of deadlocking against a limit nothing had taught it yet. It shipped and
-- immediately backfired: blameFor runs for *every* stun on *every* player,
-- so any hit with no good nearby explanation got attributed to whatever
-- scored best regardless of how far away it actually was, teaching some
-- ordinary move a wildly inflated reach and making the counters accept it from
-- absurd range afterward - reported back as auto block firing on things
-- "10 million studs away". The tracked-projectile system added at the same
-- time already solves the actual ranged-move problem this was for, through
-- real position tracking rather than attribution guesswork, so the fallback
-- is gone rather than tuned - it was never needed for the fix that shipped
-- alongside it.

local pendingThrow = nil

-- Outcomes are attributed when they *resolve*, by asking which announcement
-- was most recently responsible - not when the script decides to act.
--
-- That distinction is the whole thing. Keying off our own auto block/auto manji
-- meant the tally only ever saw what the script did, so a session spent
-- blocking and countering by hand recorded nothing at all. Blaming at
-- resolution counts every block and every counter, whoever pressed it.
-- Whether a move can be blocked is learned by watching guards succeed and
-- fail. The mistake before was only ever watching our own: a move we had
-- never personally blocked could never be classified, and auto block skipping
-- the ones it had written off meant it stopped gathering evidence about
-- exactly the moves it was least sure of.
--
-- Both of the signals involved are broadcast for every player, not just us -
-- BlockService.Effects plays the block clink at whoever blocked, and Info is
-- readable on everyone. So every guard anyone on the server puts up is a
-- sample. A move nobody has ever blocked stays unknown, which is the honest
-- answer, but it stops being the common case.
local lastBlockConfirm = setmetatable({}, { __mode = 'k' })
local BLOCK_FLINCH_GAP = 0.35

local function resolveBlock(char, perfect)
    lastBlockConfirm[char] = tick()
    local blame = blameFor(char, tick())
    if not blame then return end
    local entry = outcomeFor(blame.key)
    entry.blocked = entry.blocked + 1
    if isOwn(char) then
        pushFeed(('%s blocked%s'):format(blame.key, perfect and ' (perfect)' or ''), 'success')
    end
end

-- A stun landing on someone whose guard was up means the attack beat it.
local function failBlock(char)
    -- Unless their guard had just been confirmed absorbing something: a
    -- successful block still flinches, and counting that flinch as a failure
    -- would mark every blockable move unblockable.
    local confirmed = lastBlockConfirm[char]
    if confirmed and tick() - confirmed < BLOCK_FLINCH_GAP then
        return
    end
    local blame = blameFor(char, tick())
    if not blame then return end
    local entry = outcomeFor(blame.key)
    entry.pierced = entry.pierced + 1
    if isOwn(char) then
        pushFeed(('%s went through the block'):format(blame.key), 'warn')
    end
end

local function resolveThrow(hit)
    if not pendingThrow or pendingThrow.done then return end
    pendingThrow.done = true
    pendingThrow.hit = hit
    local entry = outcomeFor(pendingThrow.key)
    if hit then
        entry.countered = entry.countered + 1
    else
        entry.whiffed = entry.whiffed + 1
    end
end

-- Every Manji Kick announces its own startup, ours included, so this fires
-- whether the script threw it or we did.
local function noteThrow()
    -- our own startup coming back is the proof a throw actually went out
    if Counter.manji then Counter.manji.confirmedAt = tick() end
    local blame = blameFor(ownCharacter(), tick())
    local timeLeft = 0
    local key = 'unprovoked'
    if blame then
        local lead = predictedLead(blame.key) or ManjiConfig_AssumeLead or 0.35
        timeLeft = (blame.at + lead) - tick()
        key = blame.key
    end
    pendingThrow = recordThrow(timeLeft, Counter.rtt and Counter.rtt() or 0)
    pendingThrow.key = key
    local throw = pendingThrow
    task.delay(1.2, function()
        if throw and not throw.done then
            resolveThrow(false)
        end
    end)
end

-- Assigned by the overlay further down, which cannot be defined before this
-- point because it needs distanceTo. Declared here so the Effects hook binds
-- to this local rather than compiling into a nil global lookup.
local noteEspMove

--// Tracked projectiles ------------------------------------------------------
-- Every ranged moveset in this game shares one mechanism: an "Interp"
-- announcement hands over a bare BasePart (no character, so actorFrom finds
-- nothing) and the client itself carries it forward at a constant speed
-- every Stepped frame via workspace:BulkMoveTo. The part is real and it
-- really moves through workspace, which means its time to reach us is not
-- something to predict from an announcement-to-stun average at all - it is
-- distance divided by however fast it is actually observed moving, recomputed
-- every frame from its own live position. That sidesteps the single biggest
-- problem with the Effects-based lead: a fixed average lead is meaningless
-- for a move whose real flight time scales with how far away it was thrown
-- from, since a close shot and a cross-map shot get blended into one number
-- that fits neither. Declared here, ahead of hookService below, since that is
-- where an Interp announcement is actually caught.
-- Grouped into one table rather than one local apiece: this script is a
-- single top-level chunk and Luau caps a chunk at 200 locals, a ceiling this
-- file was already close to.
local Projectiles = {
    Tracked = {},
    MaxAge = 6,
    MinSpeed = 5,
    Alignment = 0.85,
}

function Projectiles.partFrom(...)
    for index = 1, select('#', ...) do
        local value = select(index, ...)
        if typeof(value) == 'Instance' and value:IsA('BasePart') then
            return value
        end
    end
    return nil
end

function Projectiles.note(serviceName, part)
    for _, rec in ipairs(Projectiles.Tracked) do
        if rec.part == part then return end
    end
    local now = tick()
    Projectiles.Tracked[#Projectiles.Tracked + 1] = {
        part = part,
        key = timingKey(serviceName, 'Interp'),
        service = serviceName,
        startedAt = now,
        lastPos = part.Position,
        lastT = now,
        speed = 0,
        velocity = Vector3.new(),
    }
end

function Projectiles.update()
    local now = tick()
    for index = #Projectiles.Tracked, 1, -1 do
        local rec = Projectiles.Tracked[index]
        local part = rec.part
        if not part.Parent or now - rec.startedAt > Projectiles.MaxAge then
            table.remove(Projectiles.Tracked, index)
        else
            local dt = now - rec.lastT
            if dt > 0.01 then
                local pos = part.Position
                rec.velocity = (pos - rec.lastPos) / dt
                rec.speed = rec.velocity.Magnitude
                rec.lastPos = pos
                rec.lastT = now
            end
        end
    end
end

-- The most urgent tracked projectile actually heading at us, in the same
-- shape Counter.threats lists announcements in, so auto block cannot tell
-- the two apart.
function Projectiles.threat()
    local mine = ownCharacter()
    local myPos = mine and positionOf(mine)
    if not myPos then return nil end
    local best, bestTimeLeft = nil, math.huge
    for _, rec in ipairs(Projectiles.Tracked) do
        if rec.speed > Projectiles.MinSpeed then
            local toUs = myPos - rec.lastPos
            local distance = toUs.Magnitude
            if distance > 0.01 then
                local towardUs = toUs.Unit:Dot(rec.velocity.Unit)
                if towardUs >= Projectiles.Alignment then
                    local timeLeft = distance / rec.speed
                    if timeLeft < bestTimeLeft then
                        best, bestTimeLeft = rec, timeLeft
                    end
                end
            end
        end
    end
    if not best then return nil end
    return {
        event = { key = best.key, service = best.service, at = best.startedAt, projectile = true },
        actor = best.part,
        distance = (myPos - best.lastPos).Magnitude,
        measured = true,
        samples = 1,
        timeLeft = bestTimeLeft,
    }
end

local ServiceHooks = { Done = {}, RetryWatched = {} }

-- Info states already accounted for elsewhere in this script (watchInfo,
-- further down). Anything else is unhandled by name; DebugStates also gates
-- the "no actor" log just below, so both diagnostics share one toggle.
local KNOWN_INFO_STATES = {
    Stun = true, Block = true, IFrame = true, InSkill = true,
    NoBlock = true, Wakeup = true,
}

local DebugStates = { Enabled = false, Seen = {} }

local function hookService(serviceFolder)
    if ServiceHooks.Done[serviceFolder] then return end
    local re = serviceFolder:FindFirstChild('RE')
    local effects = re and re:FindFirstChild('Effects')
    local isEffects = effects
        and (effects:IsA('RemoteEvent') or effects:IsA('UnreliableRemoteEvent'))
    if not isEffects then
        -- RE.Effects sometimes replicates in after the service folder itself
        -- already exists, and Services.ChildAdded below only fires for a new
        -- service folder appearing - never for something showing up inside
        -- one that was already there. Without this, a service whose Effects
        -- remote was simply a beat late never gets a second chance and stays
        -- unhooked for the rest of the session, silently, with no error.
        if not ServiceHooks.RetryWatched[serviceFolder] then
            ServiceHooks.RetryWatched[serviceFolder] = true
            serviceFolder.DescendantAdded:Connect(function()
                pcall(hookService, serviceFolder)
            end)
        end
        return
    end
    ServiceHooks.Done[serviceFolder] = true
    Intel.Hooked = Intel.Hooked + 1

    local serviceName = serviceFolder.Name:gsub('Service$', '')
    effects.OnClientEvent:Connect(function(effectName, ...)
        if not IntelConfig.Enabled then return end

        -- BlockService is the one service whose Effects payload is not
        -- (effectName, ...) but (character, wasPerfect) - the game uses it to
        -- play the block clink. Naming us means a block of ours just absorbed
        -- a hit, which is the only positive proof that what we blocked was
        -- blockable from where we were standing.
        if serviceName == 'Block' then
            if Outcomes.Enabled and typeof(effectName) == 'Instance' then
                local perfect = ...
                resolveBlock(effectName, perfect and true or false)
            end
            return
        end

        if type(effectName) ~= 'string' then return end

        -- Every ranged moveset's projectile carries itself with this same
        -- announcement - see the tracked-projectiles section
        -- for why it gets tracked directly instead of going through actorFrom
        -- and the announcement-lead system below at all.
        if effectName == 'Interp' then
            local part = Projectiles.partFrom(...)
            if part then
                Projectiles.note(serviceName, part)
            end
            return
        end

        -- ManjiKick's Hit names attacker and victim, so a Hit naming us is an
        -- unambiguous "the counter caught something". Checked before the
        -- impact-effect filter below, which exists to keep hit-time events out
        -- of the *threat* feed and would otherwise drop this too.
        --
        -- This used to fall through into the generic path below after this
        -- block, same as any other service. Its own Startup and Fade are
        -- neither in IMPACT_EFFECTS nor contain "Hit", so is_impact_effect
        -- never caught them either, and they landed in noteAnnouncement -
        -- the exact table Counter.threats scans for something worth putting a
        -- guard up against. A counter kick is not an attack the block system
        -- should ever be reasoning about, ours or an opponent's - it is what
        -- happens to whoever overswung, not a move that respects the block
        -- rules the rest of this file measures. That is what "literally
        -- tried to block manji kick which is a counter" was: an opponent's
        -- ManjiKick Startup, recorded as a plain incoming attack because
        -- nothing ever told this handler ManjiKick was different. It is
        -- fully special-cased above already, so it returns unconditionally
        -- below rather than also being run through logic built for moves
        -- that actually are attacks.
        if serviceName == 'ManjiKick' then
            if Outcomes.Enabled then
                local first = ...
                if typeof(first) == 'Instance' and isOwn(first) then
                    if effectName == 'Startup' then
                        noteThrow()
                    elseif effectName == 'Hit' or effectName == 'Fade' then
                        -- Hit is the counter's kick connecting, Fade the dodge
                        -- afterimage; either means it caught something.
                        resolveThrow(true)
                    end
                end
            end
            return
        end

        local actor = actorFrom(...)
        if not actor then
            -- actorFrom only accepts a Model with a HumanoidRootPart, which a
            -- thrown projectile's own announcement may not pass - the ball
            -- itself, not the character who threw it. A ranged move whose
            -- Effects never yield an actor this way is silently invisible to
            -- everything below, which is worth surfacing rather than guessing
            -- at blind.
            if DebugStates.Enabled then
                pushFeed(('[no actor] %s.%s'):format(serviceName, tostring(effectName)), 'warn')
            end
            return
        end
        if is_impact_effect(effectName) then return end

        local distance = distanceTo(actor)
        if distance > IntelConfig.Range then return end

        local mine = isOwn(actor)
        noteAnnouncement(serviceName, effectName, actor, mine)
        -- Recorded above so a stun we cause can be attributed, but our own
        -- moves are not threats and do not belong in the feed or on a tag.
        if mine then
            if not Counter.NonAttack[effectName] then Counter.lastOwnAttack = tick() end
            return
        end

        -- React the moment it lands rather than on the next Heartbeat, and
        -- count it toward telling attacks from dashes and auras.
        pcall(Counter.noteSeen, timingKey(serviceName, effectName), actor)
        pcall(Counter.step)

        if noteEspMove then
            noteEspMove(actor, serviceName, effectName)
        end

        local key = timingKey(serviceName, effectName)
        if not shouldLog(actor, key) then return end

        local lead, samples = predictedLead(key)
        local combo = comboIndexFrom(...)
        local label = combo and ('%s m%d'):format(serviceName, combo) or serviceName
        local verdict = blockVerdict(key)
        local mark = verdict == 'unblockable' and '  UNBLOCKABLE'
            or (verdict == 'blockable' and '  blockable' or '')
        local text
        if lead then
            text = ('%s  %s  %.0fst  ~%.2fs lead (n=%d)%s')
                :format(actor.Name, label, distance, lead, samples, mark)
        else
            text = ('%s  %s  %.0fst  lead unknown%s'):format(actor.Name, label, distance, mark)
        end
        pushFeed(text, verdict == 'unblockable' and 'warn' or (lead and 'info' or nil))
    end)
end

local function hookAllServices()
    for _, folder in ipairs(Services:GetChildren()) do
        pcall(hookService, folder)
    end
    Services.ChildAdded:Connect(function(folder)
        task.wait(0.1)
        pcall(hookService, folder)
    end)
end


--// Stun clock ---------------------------------------------------------------
-- The server never sends how long a stun lasts, so this pairs the two things
-- that are knowable: the moment it started, which is visible, and the learned
-- duration for whatever caused it. Elapsed against that gives a countdown.
--
-- It is a prediction and is labelled as one. With no measurement for the move
-- it shows how long the stun has been running instead, which is at least a
-- fact.

local stunClock = setmetatable({}, { __mode = 'k' })   -- character -> clock

local function beginStun(char, key)
    local predicted = key and predictedStun(key) or nil
    stunClock[char] = {
        start = tick(),
        key = key,
        predicted = predicted,
    }
end

local function endStun(char)
    stunClock[char] = nil
end

-- Returns remaining seconds and whether that is a prediction or just elapsed
-- time. nil when the character is not stunned at all.
local function stunRemaining(char)
    local clock = stunClock[char]
    if not clock then
        -- Ragdoll has no clock of its own; the attribute is all there is.
        if isRagdolled(char) then
            return nil, 'ragdoll'
        end
        return nil, nil
    end
    local elapsed = tick() - clock.start
    if not clock.predicted then
        return nil, ('%.1fs so far'):format(elapsed)
    end
    return math.max(0, clock.predicted - elapsed), nil
end

local function stunText(char)
    local remaining, note = stunRemaining(char)
    if remaining then
        return ('%.1fs left'):format(remaining)
    end
    return note
end

--// Overlay -----------------------------------------------------------------
-- The feed answers "what is happening" but only if you are looking at the
-- menu. This puts the same state over the player it belongs to: what they are
-- doing right now, whether they are open, and how close they are to escaping.

local EspConfig = {
    Enabled = false,
    Range = 250,
    ShowState = true,
    ShowMove = true,
    ShowEvade = true,
    ShowBurst = true,
    ShowDistance = false,
    ShowStunClock = true,
    TextSize = 14,
}

local esp = {}          -- character -> { gui, ... }
local espMoveUntil = {} -- character -> { text, until }

local ESP_STATE_COLOR = {
    stunned = Color3.fromRGB(126, 217, 87),
    ragdolled = Color3.fromRGB(126, 217, 87),
    ['i-frames'] = Color3.fromRGB(255, 96, 106),
    blocking = Color3.fromRGB(255, 196, 87),
    ['in a skill'] = Color3.fromRGB(255, 196, 87),
}

local function destroyEsp(char)
    local entry = esp[char]
    if not entry then return end
    pcall(function()
        entry.gui:Destroy()
    end)
    esp[char] = nil
end

local function clearEsp()
    for char in pairs(esp) do
        destroyEsp(char)
    end
    table.clear(espMoveUntil)
end

local function buildEsp(char)
    local head = char:FindFirstChild('Head') or char:FindFirstChild('HumanoidRootPart')
    if not head then return nil end

    -- Parented to the character rather than to a ScreenGui, so it follows the
    -- model and dies with it if the script is ever torn down mid-round.
    local gui = Instance.new('BillboardGui')
    gui.Name = 'centrl_esp'
    gui.Adornee = head
    gui.AlwaysOnTop = true
    gui.Size = UDim2.new(0, 220, 0, 66)
    gui.StudsOffset = Vector3.new(0, 3.2, 0)
    gui.MaxDistance = EspConfig.Range
    gui.ResetOnSpawn = false

    local layout = Instance.new('UIListLayout', gui)
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 1)

    local function line(order, size, color)
        local label = Instance.new('TextLabel', gui)
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 0, size + 3)
        label.Font = Enum.Font.GothamBold
        label.TextSize = size
        label.TextColor3 = color
        label.TextStrokeTransparency = 0.4
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.LayoutOrder = order
        label.Text = ''
        return label
    end

    local entry = {
        gui = gui,
        name = line(0, EspConfig.TextSize, Color3.new(1, 1, 1)),
        state = line(1, EspConfig.TextSize - 2, Color3.new(1, 1, 1)),
        move = line(2, EspConfig.TextSize - 2, Color3.fromRGB(180, 160, 255)),
    }

    -- A bar rather than a number: the evade meter matters as "how full", and
    -- a filling bar reads at a glance in a fight where a number does not.
    local track = Instance.new('Frame', gui)
    track.Name = 'evade'
    track.Size = UDim2.new(0, 90, 0, 4)
    track.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    track.BorderSizePixel = 0
    track.LayoutOrder = 3
    local trackCorner = Instance.new('UICorner', track)
    trackCorner.CornerRadius = UDim.new(0, 2)
    local fill = Instance.new('Frame', track)
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(120, 180, 255)
    fill.BorderSizePixel = 0
    local fillCorner = Instance.new('UICorner', fill)
    fillCorner.CornerRadius = UDim.new(0, 2)
    entry.evadeTrack = track
    entry.evadeFill = fill

    gui.Parent = char
    esp[char] = entry
    return entry
end

local function paintEsp(char, entry)
    local label = describeState(char)
    entry.name.Text = char.Name
    entry.name.Visible = true

    if EspConfig.ShowDistance then
        entry.name.Text = ('%s  %.0fst'):format(char.Name, distanceTo(char))
    end

    if EspConfig.ShowState then
        local burst = EspConfig.ShowBurst and canBurst(char)
        local clock = EspConfig.ShowStunClock and stunText(char)
        if clock then
            label = label .. '  ' .. clock
        end
        entry.state.Text = burst and (label .. '  |  burst') or label
        entry.state.TextColor3 = ESP_STATE_COLOR[label] or Color3.fromRGB(190, 190, 190)
        entry.state.Visible = true
    else
        entry.state.Visible = false
    end

    if EspConfig.ShowMove then
        local pending = espMoveUntil[char]
        if pending and tick() < pending.stop then
            entry.move.Text = pending.text
            entry.move.TextColor3 = pending.unblockable
                and Color3.fromRGB(255, 96, 106)
                or Color3.fromRGB(180, 160, 255)
            entry.move.Visible = true
        else
            entry.move.Visible = false
            entry.move.Text = ''
        end
    else
        entry.move.Visible = false
    end

    if EspConfig.ShowEvade then
        local meter = math.clamp(evadeMeter(char) / 50, 0, 1)
        entry.evadeFill.Size = UDim2.new(meter, 0, 1, 0)
        -- Full means they can dash straight out of a ragdoll, which is the one
        -- value worth a colour change.
        entry.evadeFill.BackgroundColor3 = meter >= 1
            and Color3.fromRGB(255, 96, 106)
            or Color3.fromRGB(120, 180, 255)
        entry.evadeTrack.Visible = true
    else
        entry.evadeTrack.Visible = false
    end
end

-- Called from the Effects hook so the overlay names the move as it starts.
function noteEspMove(char, service, effect)
    if not EspConfig.Enabled or not EspConfig.ShowMove then return end
    local key = timingKey(service, effect)
    local lead = predictedLead(key)
    local verdict = blockVerdict(key)
    espMoveUntil[char] = {
        text = verdict == 'unblockable' and (service .. '  UNBLOCKABLE') or service,
        unblockable = verdict == 'unblockable',
        stop = tick() + math.max(0.6, (lead or 0.4) + 0.5),
    }
end

local function refreshEsp()
    if not EspConfig.Enabled then
        if next(esp) then clearEsp() end
        return
    end
    local folder = charactersFolder()
    if not folder then return end

    local live = {}
    for _, char in ipairs(folder:GetChildren()) do
        if not isOwn(char) and char:FindFirstChild('HumanoidRootPart') then
            if distanceTo(char) <= EspConfig.Range then
                live[char] = true
                local entry = esp[char]
                if not entry or not entry.gui.Parent then
                    entry = buildEsp(char)
                end
                if entry then
                    entry.gui.MaxDistance = EspConfig.Range
                    paintEsp(char, entry)
                end
            end
        end
    end
    for char in pairs(esp) do
        if not live[char] then
            destroyEsp(char)
        end
    end
end

--// Measuring what we get hit by ---------------------------------------------
-- Watch Info on every character. When a Stun appears, blame the most recent
-- nearby announcement and start a clock; when it is destroyed, close the
-- sample. Watching everyone rather than only ourselves fills the table far
-- faster, at the cost of noisier attribution in a group fight.

local watchedInfo = setmetatable({}, { __mode = 'k' })

-- Info states already accounted for elsewhere in this script. Anything else
-- that shows up here is unhandled - kept as a general diagnostic even now
-- that Chase is known to announce through the same per-moveset Effects path
-- as everything else (as "(Moveset).Chase"), in case some other move turns
-- out to rely on Info state instead of an announcement.
local function watchedInfo_debugLog(char, state)
    if not DebugStates.Enabled then return end
    if KNOWN_INFO_STATES[state.Name] then return end
    local firstSeen = not DebugStates.Seen[state.Name]
    DebugStates.Seen[state.Name] = true
    pushFeed(('[state] %s -> %s%s'):format(char.Name, state.Name, firstSeen and '  (new)' or ''),
        firstSeen and 'warn' or nil)
end

local function watchInfo(char)
    local info = infoOf(char)
    if not info or watchedInfo[info] then return end
    watchedInfo[info] = true

    info.ChildAdded:Connect(function(state)
        watchedInfo_debugLog(char, state)
        if state.Name ~= 'Stun' then return end
        -- Anyone's broken guard is worth knowing about, not only ours.
        if Outcomes.Enabled and hasState(char, 'Block') then
            failBlock(char)
        end
        local startedAt = tick()
        local blame, reached = blameFor(char, startedAt)
        beginStun(char, blame and blame.key or nil)
        state.Destroying:Connect(function()
            endStun(char)
        end)

        if not Intel.Learning then return end
        if not blame then return end
        local ragdolled = isRagdolled(char)
        -- Destroying rather than ChildRemoved: Debris destroys the instance,
        -- and Destroying fires for that while ChildRemoved would also fire if
        -- the whole character were being torn down.
        state.Destroying:Connect(function()
            local duration = tick() - startedAt
            -- A stun that outlives the attribution window is almost certainly
            -- a chain of several moves, not one long one.
            if duration > 12 then return end
            recordSample(blame.key, startedAt - blame.at, duration, ragdolled, reached)
        end)
    end)
end

local function watchCharacters()
    local folder = charactersFolder()
    if not folder then
        workspace.ChildAdded:Connect(function(child)
            if child.Name == 'Characters' then
                task.wait(0.2)
                watchCharacters()
            end
        end)
        return
    end
    for _, char in ipairs(folder:GetChildren()) do
        pcall(watchInfo, char)
    end
    folder.ChildAdded:Connect(function(char)
        -- Info is parented in a moment after the model itself.
        for _ = 1, 20 do
            if infoOf(char) then break end
            task.wait(0.1)
        end
        pcall(watchInfo, char)
    end)
end

--// Counter automation -------------------------------------------------------
-- Auto block and auto manji share one picture of what is coming at us, built
-- fresh every frame - and again the instant an announcement arrives, so a
-- reaction never waits for the next Heartbeat:
--
--   what   every recent announcement from someone else, and every tracked
--          projectile, that is an attack: a basic swing, a move that has
--          stunned somebody or hit a guard, or one not yet seen enough to rule
--          out. Not one that has gone off beside people over and over without
--          ever hurting anyone - a dash, a sprint, an aura.
--   who    whether it is us they are going for. We have to be inside the
--          move's reach, where a learned reach only ever extends the slider
--          and never shrinks below it, and where someone already running at us
--          counts as closer by the ground they cover before it lands. They
--          must not be facing away from us, and nobody else standing in front
--          of them may be the obvious target instead.
--   when   how long until it lands, from the move's measured lead, judged
--          against the whole round trip: a guard or a counter has to reach the
--          server before the hit does, not merely leave here in time.
--
-- Neither action is trusted just because the call returned. A block counts
-- once the server has put Block in our Info; a counter once our own Manji
-- Kick startup comes back. A way of pressing it that twice produces nothing
-- is dropped for the next one, so whichever of the game's controller, the
-- key, or the remote actually works on this version of the game gets found by
-- itself instead of silently doing nothing.

local ToolController = nil

local function toolController()
    if ToolController then return ToolController end
    local ok, controller = pcall(function()
        return Knit.GetController("ToolController")
    end)
    if ok and controller then
        ToolController = controller
    end
    return ToolController
end

local ManjiConfig = {
    Enabled = false,
    Method = 'Auto',
    -- Turn to the attacker as it goes out; the kick comes out forwards.
    Face = true,
    -- How long the counter stays up once it reaches the server. A setting
    -- until enough throws have connected to measure it.
    Window = 0.5,
    AutoWindow = true,
    -- A counter kick answers something that has to reach you, so it is held
    -- to melee: this range, which a learned reach may stretch to at most
    -- double, and never a thrown projectile.
    Range = 22,
    MeleeOnly = true,
    OnlyMe = true,
    UseUnmeasured = true,
    AssumeLead = 0.35,
    Attempts = 0,
    Skipped = 0,
    Last = 'idle',
    Using = '-',
}

local BlockConfig = {
    Enabled = false,
    Method = 'Auto',
    Key = 'F',
    -- Turn into the attack and keep turning with it while holding. This used
    -- to be the opposite - anything more than 75 degrees off our facing was
    -- simply not blocked - which is why hits from the side walked straight in.
    Face = true,
    -- Guard goes up once a hit is this close, on top of the round trip.
    LookAhead = 0.6,
    -- And stays up this long past the last hit it was held for, so a chain
    -- gets one continuous guard instead of dropping between swings.
    Release = 0.3,
    Range = 30,
    Projectiles = true,
    OnlyMe = true,
    NotAttacking = false,
    SkipUnblockable = true,
    DodgeUnblockable = false,
    RetryChance = 0.15,
    UseUnmeasured = true,
    AssumeLead = 0.35,
    Attempts = 0,
    Skipped = 0,
    Last = 'idle',
    Using = '-',
}

-- Called every frame, so it repaints only on an actual change.
local function setStatus(which, text)
    if which.Last == text then return end
    which.Last = text
    if statusSink then statusSink() end
end

Counter.Methods = {
    Block = { 'Controller', 'Key', 'Remote' },
    Manji = { 'Tool', 'KeyBind', 'Press', 'Remote' },
}
-- Whatever the ToolController calls its release, if it has one.
Counter.UnblockNames = { 'Unblock', 'UnBlock', 'StopBlock', 'StopBlocking', 'EndBlock', 'BlockEnd', 'ReleaseBlock' }
Counter.NumberKeys = { 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine' }
-- Announcements that are never an attack in themselves.
Counter.NonAttack = {
    Dash = true, Sprint = true, Run = true, Walk = true, Jump = true, Equip = true,
    Unequip = true, Idle = true, Taunt = true, Trail = true, Aura = true, Fade = true,
}
Counter.HarmlessAfter = 8    -- announcements beside someone with no stun, no guard hit
Counter.NearVictim = 20      -- studs from the actor that make someone a possible victim
Counter.FacingAway = 110     -- degrees off their facing at which we are behind them
Counter.TargetMargin = 25    -- how clearly someone else must be the target to skip
Counter.Tail = 0.25          -- how long past its hit time a threat still counts
Counter.ConfirmWait = 0.3    -- plus the round trip, before a press counts as missed
Counter.OwnAttackGap = 0.4   -- "attacking" means one of ours went out this recently

Counter.seen = {}
Counter.lastOwnAttack = 0
Counter.dodgedUntil = 0
Counter.retry = setmetatable({}, { __mode = 'k' })   -- event -> rolled retry
Counter.counted = setmetatable({}, { __mode = 'k' }) -- event -> already tallied
Counter.block = { index = 1, misses = 0, asked = nil, ours = false, pressedWith = nil, liveUntil = 0, target = nil }
Counter.manji = { index = 1, misses = 0, asked = nil, busyUntil = 0, firedAt = 0, confirmedAt = 0 }

-- The whole round trip, in seconds. GetNetworkPing reads about half of it, so
-- it is doubled, and the network stats' data ping wins when it is larger.
function Counter.rtt()
    local now = tick()
    if Counter.rttValue and now - Counter.rttAt < 0.5 then return Counter.rttValue end
    local rtt = 0
    local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
    if ok and type(ping) == 'number' and ping > 0 then rtt = ping * 2 end
    local okStats, ms = pcall(function()
        return game:GetService('Stats').Network.ServerStatsItem['Data Ping']:GetValue()
    end)
    if okStats and type(ms) == 'number' and ms / 1000 > rtt then rtt = ms / 1000 end
    if rtt <= 0 then rtt = 0.12 end
    Counter.rttValue, Counter.rttAt = math.min(rtt, 0.6), now
    return Counter.rttValue
end

function Counter.isM1(effect)
    return type(effect) == 'string' and effect:match('^Swing%d*$') ~= nil
end

-- Whether an announcement is an attack, and whether that is known rather
-- than assumed. Anything that has stunned someone or met a guard is one; a
-- basic swing always is; a name that is never one is not; and something that
-- keeps going off beside people without either has shown it is harmless.
function Counter.isAttack(key, effect)
    if Counter.isM1(effect) then return true, true end
    local timing = Intel.Timing[key]
    if timing and timing.n > 0 then return true, true end
    local outcome = Outcomes.Moves[key]
    if outcome and outcome.blocked + outcome.pierced + outcome.countered > 0 then return true, true end
    if Counter.NonAttack[effect] then return false end
    if (Counter.seen[key] or 0) >= Counter.HarmlessAfter then return false end
    return true, false
end

-- Counts an announcement that went off with somebody close enough to hit.
function Counter.noteSeen(key, actor)
    local origin = positionOf(actor)
    local folder = charactersFolder()
    if not origin or not folder then return end
    for _, other in ipairs(folder:GetChildren()) do
        if other ~= actor then
            local position = positionOf(other)
            if position and (position - origin).Magnitude <= Counter.NearVictim then
                Counter.seen[key] = (Counter.seen[key] or 0) + 1
                return
            end
        end
    end
end

function Counter.flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- Degrees between where `root` faces and the direction to `position`.
function Counter.angle(root, position)
    local toward = Counter.flat(position - root.Position)
    if toward.Magnitude < 0.5 then return 0 end
    local look = Counter.flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then return 0 end
    return math.deg(math.acos(math.clamp(look.Unit:Dot(toward.Unit), -1, 1)))
end

-- Whether this attacker is going for us rather than for somebody beside us.
-- Everyone they could reach is scored on how far off their facing and how far
-- away they stand; we are the target unless someone else clearly beats us.
function Counter.goingForMe(actor, mine, reach)
    local theirs = actor:FindFirstChild('HumanoidRootPart')
    local ours = mine:FindFirstChild('HumanoidRootPart')
    if not theirs or not ours then return true end
    local myAngle = Counter.angle(theirs, ours.Position)
    if myAngle > Counter.FacingAway then return false, 'facing away' end
    local myScore = myAngle + Counter.flat(ours.Position - theirs.Position).Magnitude * 2
    local folder = charactersFolder()
    if not folder then return true end
    for _, other in ipairs(folder:GetChildren()) do
        if other ~= actor and other ~= mine and not isOwn(other) and not other:GetAttribute('Dead') then
            local root = other:FindFirstChild('HumanoidRootPart')
            if root then
                local distance = Counter.flat(root.Position - theirs.Position).Magnitude
                if distance <= reach then
                    local score = Counter.angle(theirs, root.Position) + distance * 2
                    if score + Counter.TargetMargin < myScore then
                        return false, 'going for ' .. other.Name
                    end
                end
            end
        end
    end
    return true
end

-- Where a threat is right now: the attacker's root, or the projectile itself.
function Counter.whereIs(actor)
    if not actor or not actor.Parent then return nil end
    local root = actor:FindFirstChild('HumanoidRootPart')
    if root then return root.Position end
    if actor:IsA('BasePart') then return actor.Position end
    return nil
end

-- Every threat to us, soonest to land first. The second value explains why
-- the first thing passed over was passed over, for the status line.
function Counter.threats(cfg, mine, withProjectiles)
    local list, skipped = {}, nil
    local ours = mine:FindFirstChild('HumanoidRootPart')
    if not ours then return list, 'no character' end
    local now = tick()

    for index = #Intel.Recent, 1, -1 do
        local event = Intel.Recent[index]
        if now - event.at > Intel.RecentWindow then break end
        local actor = event.actor
        if not event.mine and actor and actor.Parent and not actor:GetAttribute('Dead') then
            local why
            local attack = Counter.isAttack(event.key, event.effect)
            local lead = predictedLead(event.key)
            if not attack then
                why = 'not an attack'
            elseif not lead and not cfg.UseUnmeasured and not Counter.isM1(event.effect) then
                why = 'unmeasured'
            end

            local timeLeft = event.at + (lead or cfg.AssumeLead) - now
            if not why and timeLeft < -Counter.Tail then why = 'already landed' end

            local distance
            if not why then
                distance = distanceTo(actor)
                local theirs = actor:FindFirstChild('HumanoidRootPart')
                if theirs then
                    -- someone running at us covers ground before it lands
                    local toUs = Counter.flat(ours.Position - theirs.Position)
                    if toUs.Magnitude > 0.01 then
                        local closing = Counter.flat(theirs.AssemblyLinearVelocity):Dot(toUs.Unit)
                        if closing > 0 then
                            distance = math.max(0, distance - closing * math.max(timeLeft, 0))
                        end
                    end
                end
                local learned = learnedReach(event.key)
                local reach = math.max(cfg.Range, learned and learned * REACH_MARGIN or 0)
                if cfg.MeleeOnly then reach = math.min(reach, cfg.Range * 2) end
                if distance > reach then
                    why = ('%.0fst away'):format(distance)
                elseif cfg.OnlyMe then
                    local forMe, whyNot = Counter.goingForMe(actor, mine, reach)
                    if not forMe then why = whyNot end
                end
            end

            if why then
                skipped = skipped or (why .. ': ' .. event.service)
            else
                list[#list + 1] = {
                    event = event,
                    key = event.key,
                    service = event.service,
                    effect = event.effect,
                    actor = actor,
                    timeLeft = timeLeft,
                    measured = lead ~= nil,
                    distance = distance,
                }
            end
        end
    end

    if withProjectiles then
        local projectile = Projectiles.threat()
        if projectile then
            list[#list + 1] = {
                event = projectile.event,
                key = projectile.event.key,
                service = projectile.event.service,
                effect = 'Interp',
                actor = projectile.actor,
                timeLeft = projectile.timeLeft,
                measured = true,
                distance = projectile.distance,
                projectile = true,
            }
        end
    end

    table.sort(list, function(a, b) return a.timeLeft < b.timeLeft end)
    return list, skipped or 'nothing incoming'
end

-- Turns us to look at a point, on the ground plane.
function Counter.face(mine, position)
    local root = mine and mine:FindFirstChild('HumanoidRootPart')
    if not root or not position then return end
    local flat = Vector3.new(position.X, root.Position.Y, position.Z)
    if (flat - root.Position).Magnitude < 0.5 then return end
    pcall(function()
        root.CFrame = CFrame.lookAt(root.Position, flat)
    end)
end

function Counter.vim()
    if Counter.vimService == nil then
        local ok, service = pcall(function() return game:GetService('VirtualInputManager') end)
        Counter.vimService = ok and service or false
    end
    return Counter.vimService or nil
end

-- A key from a setting or a move's Key attribute: a KeyCode, its name, or a
-- hotbar number.
function Counter.keyCode(value)
    if typeof(value) == 'EnumItem' then return value end
    if type(value) == 'number' then value = tostring(math.floor(value)) end
    if type(value) ~= 'string' or value == '' then return nil end
    local digit = tonumber(value)
    if digit and Counter.NumberKeys[digit] then return Enum.KeyCode[Counter.NumberKeys[digit]] end
    local ok, code = pcall(function() return Enum.KeyCode[value] end)
    return ok and code or nil
end

-- A real key tap, down then up, the way a finger would.
function Counter.tap(code, hold)
    local vim = Counter.vim()
    if not vim or not code then return false end
    local ok = pcall(function() vim:SendKeyEvent(true, code, false, game) end)
    if not ok then return false end
    task.delay(hold or 0.06, function()
        pcall(function() vim:SendKeyEvent(false, code, false, game) end)
    end)
    return true
end

function Counter.remote(service, name)
    local folder = Services:FindFirstChild(service)
    local re = folder and folder:FindFirstChild('RE')
    return re and re:FindFirstChild(name) or nil
end

-- The method in charge: the one picked, or on Auto the one still standing.
function Counter.method(cfg, state, list)
    if cfg.Method ~= 'Auto' then return cfg.Method end
    return list[state.index] or list[1]
end

-- A press that produced nothing. On Auto, a method that misses twice running
-- hands over to the next.
function Counter.missed(cfg, state, list, method, label)
    state.misses = state.misses + 1
    if cfg.Method == 'Auto' and state.misses >= 2 then
        state.misses = 0
        state.index = state.index % #list + 1
        pushFeed(('%s: %s did nothing, trying %s'):format(label, method, list[state.index]), 'warn')
    end
end

-- Settles the last press: confirmed, or given up on once the server has had
-- the round trip plus a margin to answer.
function Counter.settle(cfg, state, list, confirmed, label)
    local asked = state.asked
    if not asked then return end
    if confirmed then
        state.asked = nil
        state.misses = 0
        cfg.Using = asked.method
        return
    end
    if tick() - asked.at < Counter.ConfirmWait + Counter.rtt() then return end
    state.asked = nil
    Counter.missed(cfg, state, list, asked.method, label)
end

-- Tallies a skip once per announcement rather than once per frame.
function Counter.skip(cfg, threat)
    if threat and Counter.counted[threat.event] ~= cfg then
        Counter.counted[threat.event] = cfg
        cfg.Skipped = cfg.Skipped + 1
    end
end

--// Auto manji kick ----------------------------------------------------------

function Counter.manjiMove(mine)
    local move = findMove(mine, "ManjiKickService")
    if move then return move end
    -- The display name, in case the Service attribute is ever renamed.
    local moveset = movesetFolder(mine)
    return moveset and moveset:FindFirstChild("Manji Kick") or nil
end

function Counter.fireManji(method, move)
    local controller = toolController()
    if method == 'Tool' then
        if not controller then return false end
        local ok = pcall(function() controller:UseTool(move, "Activated") end)
        if ok then
            task.delay(0.06, function()
                pcall(function() controller:UseTool(move, "Deactivated") end)
            end)
        end
        return ok
    elseif method == 'KeyBind' then
        local key = move:GetAttribute("Key")
        if not controller or key == nil then return false end
        local ok = pcall(function() controller:UseKey(key, "Activated") end)
        if ok then
            task.delay(0.06, function()
                pcall(function() controller:UseKey(key, "Deactivated") end)
            end)
        end
        return ok
    elseif method == 'Press' then
        return Counter.tap(Counter.keyCode(move:GetAttribute("Key")))
    end
    local activated = Counter.remote("ManjiKickService", "Activated")
    if not activated then return false end
    return (pcall(function() activated:FireServer(move) end))
end

-- The counter has to be up on the server when the hit arrives there. Sent now
-- it arrives a round trip ahead of a hit timeLeft out (both directions of
-- delay are in it) and then lasts `window`, so it catches anything landing
-- between rtt and rtt + window from now. It goes out once the soonest threat
-- is inside that band, with a little of the window kept back for error in
-- the lead; a hit already closer than half the round trip cannot be caught
-- and is left to the block.
function Counter.manjiStep(mine, threats, reason, rtt)
    local cfg, state = ManjiConfig, Counter.manji
    local now = tick()
    local move = Counter.manjiMove(mine)

    local readyAt = move and move:GetAttribute("ReadyAt")
    local fired = state.asked and (state.confirmedAt >= state.asked.at
        or (readyAt ~= nil and readyAt ~= state.asked.readyAt))
    Counter.settle(cfg, state, Counter.Methods.Manji, fired, 'manji')

    local window = cfg.Window
    local source = 'set'
    if cfg.AutoWindow then
        local learned = learnedWindow()
        if learned then window, source = learned, 'learned' end
    end
    -- still guarding us from the last throw
    local busy = now < state.firedAt + rtt + window

    if now < state.busyUntil then return busy end
    if not move then
        setStatus(cfg, 'no manji kick on this moveset')
        return busy
    end
    local able, why = canAct(mine)
    if not able then
        setStatus(cfg, why)
        return busy
    end
    if globallyLocked(mine) then
        setStatus(cfg, 'global cooldown')
        return busy
    end
    local left = cooldownLeft(move)
    if left > 0 then
        setStatus(cfg, ('cooldown %.1fs'):format(left))
        return busy
    end

    local fireBy = rtt + window * 0.8
    local target, waiting, late
    for _, threat in ipairs(threats) do
        if threat.timeLeft < rtt * 0.5 then
            late = late or threat
        elseif threat.timeLeft <= fireBy then
            target = threat
            break
        else
            waiting = waiting or threat
        end
    end

    if not target then
        if waiting then
            setStatus(cfg, ('%s in %.2fs, goes at %.2fs (%s window)')
                :format(waiting.service, waiting.timeLeft, fireBy, source))
        elseif late then
            Counter.skip(cfg, late)
            setStatus(cfg, ('%s too close to catch (%.2fs)'):format(late.service, late.timeLeft))
        else
            setStatus(cfg, reason)
        end
        return busy
    end

    -- a counter beats a guard, and a guard would stop it coming out
    if hasState(mine, 'Block') and Counter.block.ours then Counter.releaseBlock() end
    if cfg.Face then Counter.face(mine, Counter.whereIs(target.actor)) end

    local method = Counter.method(cfg, state, Counter.Methods.Manji)
    if not Counter.fireManji(method, move) then
        setStatus(cfg, method .. ' failed')
        Counter.missed(cfg, state, Counter.Methods.Manji, method, 'manji')
        return busy
    end

    state.asked = { at = now, method = method, readyAt = readyAt }
    state.busyUntil = now + 0.4
    state.firedAt = now
    cfg.Attempts = cfg.Attempts + 1
    setStatus(cfg, ('countered %s (%.2fs)'):format(target.service, target.timeLeft))
    pushFeed(('manji -> %s in %.2fs'):format(target.service, target.timeLeft), 'success')
    return true
end

--// Auto block ---------------------------------------------------------------

function Counter.pressBlock(method, down)
    if method == 'Controller' then
        local controller = toolController()
        if not controller then return false end
        if down then
            return (pcall(function() controller:Block() end))
        end
        for _, name in ipairs(Counter.UnblockNames) do
            local release = controller[name]
            if type(release) == 'function' then pcall(release, controller) end
        end
        local deactivated = Counter.remote("BlockService", "Deactivated")
        if deactivated then pcall(function() deactivated:FireServer() end) end
        return true
    elseif method == 'Key' then
        local vim, code = Counter.vim(), Counter.keyCode(BlockConfig.Key)
        if not vim or not code then return false end
        return (pcall(function() vim:SendKeyEvent(down, code, false, game) end))
    end
    local remote = Counter.remote("BlockService", down and "Activated" or "Deactivated")
    if not remote then return false end
    return (pcall(function() remote:FireServer() end))
end

-- Drops a guard we put up, the same way it went up, and tells the server
-- directly as well so a release can never be the thing that sticks.
function Counter.releaseBlock()
    local state = Counter.block
    local method = state.pressedWith or Counter.method(BlockConfig, state, Counter.Methods.Block)
    Counter.pressBlock(method, false)
    if method ~= 'Remote' then
        local deactivated = Counter.remote("BlockService", "Deactivated")
        if deactivated then pcall(function() deactivated:FireServer() end) end
    end
    state.ours = false
    state.pressedWith = nil
    state.liveUntil = 0
    state.target = nil
end

-- Backs out of something a guard will not stop.
function Counter.dodge(mine, threat)
    local now = tick()
    if now < Counter.dodgedUntil or hasState(mine, 'NoDash') then return end
    Counter.dodgedUntil = now + 1.5
    -- facing them first makes Back mean away from them
    Counter.face(mine, Counter.whereIs(threat.actor))
    pcall(function() DashRemote:FireServer("Back") end)
    local controller = getMovementController()
    if controller then
        pcall(function() controller:Dash(LocalPlayer, mine, "Back") end)
    end
    pushFeed(('dodged %s - it beats blocks'):format(threat.service), 'success')
end

-- A guard goes up for the soonest threat that will land within the round trip
-- plus the look-ahead, turns to face it, and then holds - turning with it -
-- until nothing has been due for `Release` seconds, so a chain of hits meets
-- one continuous guard. Only a guard this script raised is ever dropped by it.
function Counter.blockStep(mine, threats, reason, rtt, manjiBusy)
    local cfg, state = BlockConfig, Counter.block
    local now = tick()
    local blocking = hasState(mine, 'Block')
    Counter.settle(cfg, state, Counter.Methods.Block, blocking and state.asked ~= nil, 'block')
    -- a guard we asked for that never came, or one that has been broken: let
    -- go of whatever is still held down and start over, rather than go on
    -- "holding" a guard that is not there
    if state.ours and not blocking and not state.asked then
        Counter.releaseBlock()
    end

    local target, why
    for _, threat in ipairs(threats) do
        if threat.timeLeft > rtt + cfg.LookAhead then
            why = why or ('%s in %.2fs'):format(threat.service, threat.timeLeft)
        else
            local verdict, rate, tried = blockVerdict(threat.key)
            local beatsBlocks = cfg.SkipUnblockable and not threat.projectile and not Counter.isM1(threat.effect)
                and verdict == 'unblockable' and tried >= 5
            if beatsBlocks then
                -- rolled once per announcement: a verdict that is never
                -- retested can never be corrected
                if Counter.retry[threat.event] == nil then
                    Counter.retry[threat.event] = math.random() < cfg.RetryChance
                end
                beatsBlocks = not Counter.retry[threat.event]
            end
            if beatsBlocks then
                Counter.skip(cfg, threat)
                if cfg.DodgeUnblockable then Counter.dodge(mine, threat) end
                why = why or ('%s beats blocks (%d%%, n=%d)'):format(threat.service, math.floor(rate * 100), tried)
            else
                target = threat
                break
            end
        end
    end

    if target and cfg.NotAttacking and now - Counter.lastOwnAttack < Counter.OwnAttackGap then
        why, target = 'you are attacking', nil
    end
    if target and manjiBusy then
        why, target = 'manji has it', nil
    end
    if target then
        state.liveUntil = math.max(state.liveUntil, now + math.max(target.timeLeft, 0) + cfg.Release)
        state.target = target
    end

    -- holding: keep facing whatever the guard is for, drop it once it is over
    if state.ours then
        if now < state.liveUntil then
            if cfg.Face and state.target then Counter.face(mine, Counter.whereIs(state.target.actor)) end
            setStatus(cfg, 'holding vs ' .. (state.target and state.target.service or '?'))
        else
            Counter.releaseBlock()
            setStatus(cfg, 'released')
        end
        return
    end

    if not target then
        setStatus(cfg, blocking and 'you are blocking' or (why or reason))
        return
    end
    if blocking then
        setStatus(cfg, 'you are blocking')
        return
    end
    local able, whyNot = canAct(mine)
    if not able then
        setStatus(cfg, whyNot)
        return
    end
    if hasState(mine, 'NoBlock') then
        setStatus(cfg, 'blocking disabled on us')
        return
    end

    if cfg.Face then Counter.face(mine, Counter.whereIs(target.actor)) end
    local method = Counter.method(cfg, state, Counter.Methods.Block)
    if not Counter.pressBlock(method, true) then
        setStatus(cfg, method .. ' failed')
        Counter.missed(cfg, state, Counter.Methods.Block, method, 'block')
        return
    end

    state.asked = { at = now, method = method }
    state.ours = true
    state.pressedWith = method
    if Counter.counted[target.event] ~= 'block' then
        Counter.counted[target.event] = 'block'
        cfg.Attempts = cfg.Attempts + 1
    end
    setStatus(cfg, ('blocking %s (%.2fs)'):format(target.service, target.timeLeft))
    pushFeed(('block -> %s in %.2fs, %.0fst'):format(target.service, target.timeLeft, target.distance or 0), 'success')
end

function Counter.step()
    if not ManjiConfig.Enabled and not BlockConfig.Enabled then return end
    local mine = ownCharacter()
    if not mine then return end
    local rtt = Counter.rtt()
    local manjiBusy = false
    if ManjiConfig.Enabled then
        local threats, reason = Counter.threats(ManjiConfig, mine, not ManjiConfig.MeleeOnly)
        manjiBusy = Counter.manjiStep(mine, threats, reason, rtt)
    end
    if BlockConfig.Enabled then
        local threats, reason = Counter.threats(BlockConfig, mine, BlockConfig.Projectiles)
        Counter.blockStep(mine, threats, reason, rtt, manjiBusy)
    elseif Counter.block.ours then
        Counter.releaseBlock()
    end
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if IntelConfig.Enabled then
            pcall(Projectiles.update)
            pcall(Counter.step)
        end
    end
end)

