local OutcomeLog = OutcomeSection:Console({
    Title = 'move  /  blocked  /  pierced  /  countered',
    Height = 150,
    MaxLines = 80,
})

local function refreshOutcomes()
    local rows = {}
    for key, entry in pairs(Outcomes.Moves) do
        local total = entry.blocked + entry.pierced + entry.countered + entry.whiffed
        if total > 0 then
            table.insert(rows, { key = key, entry = entry, total = total })
        end
    end
    table.sort(rows, function(a, b) return a.total > b.total end)
    OutcomeLog:Clear()
    if #rows == 0 then
        OutcomeLog:Append('nothing tried yet - block or counter something')
    end
    for _, row in ipairs(rows) do
        local e = row.entry
        local named = blockVerdict(row.key)
        local verdict = named == 'unknown' and '' or ('  ' .. named)
        OutcomeLog:Append(('%-24s %d/%d  %d/%d%s'):format(
            row.key:sub(1, 24), e.blocked, e.blocked + e.pierced,
            e.countered, e.countered + e.whiffed, verdict))
    end
end

OutcomeSection:Button({ Title = 'refresh', Half = true, Callback = refreshOutcomes })
OutcomeSection:Button({
    Title = 'reset',
    Half = true,
    Callback = function()
        Outcomes.Moves = {}
        table.clear(Outcomes.Throws)
        refreshOutcomes()
    end,
})

OutcomeSection:Paragraph({
    Title = 'where these come from',
    Content = 'Every guard anyone on the server puts up is a sample, not just ours. BlockService announces a block absorbing a hit for whoever blocked it, and Info is readable on everyone, so blocked and pierced are counted across the whole lobby. That is the difference between classifying a move the first time somebody else eats it and never classifying it until we personally tried. countered still comes from a ManjiKick Hit naming us. All of it is server broadcast, so these are observations - but they describe what happened at that angle and range, not a property of the move.',
})

OutcomeSection:Paragraph({
    Title = 'the verdicts',
    Content = 'unknown means fewer than three attempts have been seen and it will not refuse to block on that basis. unblockable means under a third of guards survived it, and auto block stops offering itself up - though it still tries occasionally, so a wrong call can correct itself. blockable means over two thirds held. The same function decides the label and the behaviour, so they cannot disagree.',
})

