--// Void carry -------------------------------------------------------------------
-- Cursed Strikes announces itself over CursedStrikesService.RE.Effects. Two of
-- those keys are useful here:
--
--   "Hit"      (victimCharacter, wasHeavy)
--   "FinalHit" (attackerCharacter, victimCharacter)
--
-- FinalHit names both sides, so it is unambiguous. "Hit" only names the victim,
-- so it is only trusted inside a short window after we fired Activated
-- ourselves - otherwise every Cursed Strikes landing anywhere on the server
-- would trigger a carry.
local lastActivatedAt = 0
local ACTIVATION_WINDOW = 2.5
local carryActive = false

local function getOwnCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then return char end
    local chars = workspace:FindFirstChild("Characters")
    local folder = chars and chars:FindFirstChild(LocalPlayer.Name)
    if folder and folder:FindFirstChild("HumanoidRootPart") then return folder end
    return char or folder
end

-- The game keeps a character under workspace.Characters as well as the usual
-- Player.Character, and the Effects remote can hand back either, so identity
-- is checked against both rather than assuming one.
local function isOwnCharacter(model)
    if not model then return false end
    if model == LocalPlayer.Character then return true end
    local chars = workspace:FindFirstChild("Characters")
    if chars and model == chars:FindFirstChild(LocalPlayer.Name) then return true end
    return model.Name == LocalPlayer.Name
end

local function getOwnRoot()
    local char = getOwnCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getOwnHumanoid()
    local char = getOwnCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

if CursedStrikesActivated and typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
    local originalNamecall
    originalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if self == CursedStrikesActivated and getnamecallmethod() == "FireServer" then
