local COLOR_WARN = Color3.fromRGB(255, 196, 87)
local COLOR_BAD = Color3.fromRGB(255, 96, 106)

-- `openness` is how good the state is *for whoever is attacking this
-- character*: 1 wide open, -1 untouchable, 0 neither. The caller flips it for
-- our own row, so a stun on us reads red and a stun on them reads green
-- without needing two copies of the same list.
local function describeState(char)
    if not char then return 'none', 0 end
    if char:GetAttribute('Dead') then return 'dead', 0 end
    if isRagdolled(char) then return 'ragdolled', 1 end
    if hasState(char, 'Stun') then return 'stunned', 1 end
    if hasState(char, 'IFrame') then return 'i-frames', -1 end
    if hasState(char, 'Block') then return 'blocking', -1 end
    if hasState(char, 'InSkill') then return 'in a skill', -1 end
    return 'free', 0
end

local function openColor(openness)
    if openness > 0 then return COLOR_GOOD end
    if openness < 0 then return COLOR_BAD end
    return nil
end

local function currentTarget()
    local controller = toolController()
    if controller then
        local ok, target = pcall(function()
            return controller:GetTarget()
        end)
        if ok and typeof(target) == 'Instance' and target:IsA('Model') then
            return target
        end
    end
    -- No lock-on, so fall back to the nearest other character in range.
    local folder = charactersFolder()
    local mine = ownCharacter()
    if not folder or not mine then return nil end
    local best, bestDistance = nil, IntelConfig.Range
    for _, char in ipairs(folder:GetChildren()) do
        if not isOwn(char) and char:FindFirstChild('HumanoidRootPart') then
            local distance = distanceTo(char)
            if distance < bestDistance then
                best, bestDistance = char, distance
            end
        end
    end
    return best
end

