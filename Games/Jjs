-- Dash cooldown changer: hooks MovementController.DashRequest so a custom
-- cooldown applies to Back/Left/Right dashes. Front dash is a separate
-- "chase" ability (routed to the original handler untouched) since it
-- doesn't go through the same movement-dash cooldown or remote at all.
local LastCustomDash = 0
local OriginalDashRequest = nil

local function getMovementController()
    local ok, controller = pcall(function()
        return Knit.GetController("MovementController")
    end)
    if ok then return controller end
    return nil
end

local function getDashDirection(humanoid, hrp)
    local camLook = workspace.CurrentCamera.CFrame.LookVector
    local flat = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camLook.X, 0, camLook.Z))
    local forward = math.round(humanoid.MoveDirection:Dot(flat.LookVector))
    local right = math.round(humanoid.MoveDirection:Dot(flat.RightVector))
    if forward == 1 then return "Front" end
    if forward == -1 then return "Back" end
    if right == 1 then return "Right" end
    if right == -1 then return "Left" end
    return "Front"
end

local function hookDashRequest()
    if OriginalDashRequest then return true end

    local Controller = getMovementController()
    if not Controller then return false end

    OriginalDashRequest = Controller.DashRequest

    Controller.DashRequest = function(self, ...)
        if not DashConfig.Enabled then
            return OriginalDashRequest(self, ...)
        end

        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local info = character and character:FindFirstChild("Info")
        if not (character and hrp and humanoid and info) then
            return OriginalDashRequest(self, ...)
        end

        -- Unconditional knockback/burst escape dash: never gated by cooldown.
        if info:FindFirstChild("Knockback")
            or (character:GetAttribute("Burst") and not info:GetAttribute("Burst"))
            or (info:FindFirstChild("ForceEsc") and info.ForceEsc.Value) then
            return OriginalDashRequest(self, ...)
        end

        local direction = getDashDirection(humanoid, hrp)
        if direction == "Front" then
            return OriginalDashRequest(self, ...)
        end

        -- Preserve the game's own movement-state guards; only the cooldown changes.
        if info:FindFirstChild("Block") then return end
        if info:FindFirstChild("Stun") then return end
        if character:GetAttribute("Ragdoll") > 0 then return end
        local inSkill = info:FindFirstChild("InSkill")
        if inSkill and inSkill.Value == false then return end
        if info:FindFirstChild("NoDash") then return end
        local noSprint = info:FindFirstChild("NoSprint")
        if noSprint and noSprint.Value == false then return end

        if tick() - LastCustomDash < DashConfig.Cooldown then return end
        LastCustomDash = tick()

        DashRemote:FireServer(direction)
        self:Dash(LocalPlayer, character, direction)
    end

    return true
end

local function getCharFolder()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then return nil end
    return chars:FindFirstChild(LocalPlayer.Name)
end

local function getDivergentFistArg()
    local folder = getCharFolder()
    if not folder then return nil end
    local moveset = folder:FindFirstChild("Moveset")
    if not moveset then return nil end
    return moveset:FindFirstChild("Divergent Fist")
end

local function hookTrack(track, id)
    local variant = DIVERGENT_IDS[id]
    if not variant then return end

    if variant == 4 then
        task.delay(VARIANT4_DELAY, function()
            if not Config.Enabled then return end
            if not track.IsPlaying then return end
            RightActivated:FireServer()
        end)
        return
    end

    local shouldFire = math.random(1, 100) <= Config.Chance
    if not shouldFire then return end

    task.delay(BLACKFLASH_DELAY, function()
        if not Config.Enabled then return end
        if not track.IsPlaying then return end
        local arg = getDivergentFistArg()
        if arg then
            Activated:FireServer(arg)
        end
    end)
end

local function connectHumanoid(hum)
    hum.AnimationPlayed:Connect(function(track)
        if not Config.Enabled then return end
        local id = track.Animation and track.Animation.AnimationId
        if id then
            hookTrack(track, id)
        end
    end)
end

local function onCharacterAdded(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
        or char:WaitForChild("Humanoid", 5)
    if hum then
        connectHumanoid(hum)
    end
end

local function watchForCharacter()
    local chars = workspace:FindFirstChild("Characters")
    if not chars then
        workspace.ChildAdded:Connect(function(child)
            if child.Name == "Characters" then
                local playerFolder = child:WaitForChild(LocalPlayer.Name, 10)
                if playerFolder then
                    onCharacterAdded(playerFolder)
                    playerFolder.ChildAdded:Connect(function(child2)
                        if child2:IsA("Humanoid") then
                            connectHumanoid(child2)
                        end
                    end)
                end
            end
        end)
        return
    end

    local playerFolder = chars:FindFirstChild(LocalPlayer.Name)
    if playerFolder then
        onCharacterAdded(playerFolder)
        playerFolder.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then
                connectHumanoid(child)
            end
        end)
    else
        chars.ChildAdded:Connect(function(child)
            if child.Name == LocalPlayer.Name then
                onCharacterAdded(child)
                child.ChildAdded:Connect(function(child2)
                    if child2:IsA("Humanoid") then
                        connectHumanoid(child2)
                    end
                end)
            end
        end)
    end
end

