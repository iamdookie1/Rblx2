local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local Config = {
    Enabled = false,
    Chance = 100,
}


local BLACKFLASH_DELAY = 0.212
local VARIANT4_DELAY = 0.4

-- Black flash timing under lag.
--
-- The old version slept for a fixed 0.212s with task.delay and fired. Two
-- things break that when the connection is poor:
--
--   task.delay counts wall-clock seconds, but the swing it is trying to hit
--   is an animation. A frame hitch delays the animation without delaying the
--   timer, so the fire lands at the wrong point of a swing that has not got
--   there yet.
--
--   Even with perfect local timing, the remote still has to travel. The server
--   judges the window against when it *receives* the fire, so a 90ms ping puts
--   every attempt 90ms late no matter how well the client timed it.
--
-- So the trigger reads the animation's own clock instead of sleeping, and
-- fires early by the measured ping. What is left after that is whatever the
-- ping figure gets wrong, which is what the tuner below is for.
local FlashTune = {
    PingComp = true,
    AutoTune = true,
    -- Extra lead tried on top of ping compensation, in seconds. Kept small:
    -- this is correcting the error in a latency estimate, not the delay.
    Candidates = { -0.06, -0.04, -0.02, 0, 0.02, 0.04, 0.06 },
    Stats = {},          -- offset -> { n, hit }
    Current = 0,
    Attempts = 0,
    Hits = 0,
    Pending = nil,
    MinSamples = 4,
    ExploreChance = 0.25,
}

local function flashStat(offset)
    local entry = FlashTune.Stats[offset]
    if not entry then
        entry = { n = 0, hit = 0 }
        FlashTune.Stats[offset] = entry
    end
    return entry
end

-- Mostly use the best offset seen so far, but keep sampling the others: a
-- candidate that lost its first two coin flips would otherwise never be tried
-- again, and ping drifts over a session anyway.
local function pickOffset()
    if not FlashTune.AutoTune then
        return 0
    end
    if math.random() < FlashTune.ExploreChance then
        return FlashTune.Candidates[math.random(1, #FlashTune.Candidates)]
    end
    local best, bestRate = nil, -1
    for _, offset in ipairs(FlashTune.Candidates) do
        local entry = FlashTune.Stats[offset]
        if entry and entry.n >= FlashTune.MinSamples then
            local rate = entry.hit / entry.n
            if rate > bestRate then
                best, bestRate = offset, rate
            end
        end
    end
    return best or 0
end

local function currentPing()
    if not FlashTune.PingComp then return 0 end
    local ok, ping = pcall(function()
        return LocalPlayer:GetNetworkPing()
    end)
    if ok and type(ping) == 'number' and ping >= 0 then
        -- GetNetworkPing reports seconds. Capped so a spike cannot pull the
        -- fire back before the swing has started.
        return math.clamp(ping, 0, BLACKFLASH_DELAY * 0.75)
    end
    return 0
end

local Services = ReplicatedStorage.Knit.Knit.Services
local Activated = Services.DivergentFistService.RE.Activated
local RightActivated = Services.ItadoriService.RE.RightActivated
local DashRemote = Services.MovementService.RE.Dash


