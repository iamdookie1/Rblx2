statusSink = function()
    ManjiStatus:Set(ManjiConfig.Last)
    ManjiCount:Set(ManjiConfig.Attempts .. ' / ' .. ManjiConfig.Skipped)
    BlockStatus:Set(BlockConfig.Last)
    BlockCount:Set(BlockConfig.Attempts .. ' / ' .. BlockConfig.Skipped)
    local function using(cfg, state, list)
        local method = Counter.method(cfg, state, list)
        return cfg.Method == 'Auto' and ('auto: ' .. method) or method
    end
    ManjiConfig.UsingStat:Set(using(ManjiConfig, Counter.manji, Counter.Methods.Manji))
    BlockConfig.UsingStat:Set(using(BlockConfig, Counter.block, Counter.Methods.Block))
end

task.spawn(function()
    local lastTimingRefresh = 0
    while true do
        task.wait(0.2)

        local mine = ownCharacter()
        SState:Set(describeState(mine))
        SEvade:Set(evadeMeter(mine))
        SBurst:Set(canBurst(mine) and 'ready' or 'spent')

        local move = mine and Counter.manjiMove(mine)
        if not move then
            SManji:Set('not equipped')
        else
            local left = cooldownLeft(move)
            if left > 0 then
                SManji:Set(('%.1fs'):format(left))
            else
                SManji:Set('ready')
            end
        end

        local target = currentTarget()
        if target then
            TName:Set(target.Name)
            TDist:Set(('%.0f st'):format(distanceTo(target)))
            TState:Set(describeState(target))
            TEvade:Set(evadeMeter(target))
            TBurst:Set(canBurst(target) and 'ready' or 'spent')
            local left, note = stunRemaining(target)
            if left then
                TStun:Set(('%.1fs'):format(left))
            else
                TStun:Set(note or '-')
            end
        else
            TName:Set('-')
            TDist:Set('-')
            TState:Set('-')
            TEvade:Set(0)
            TBurst:Set('-')
            TStun:Set('-')
        end

        pcall(refreshEsp)

        do
            local ok, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
            FlashPing:Set(ok and type(ping) == 'number'
                and ('%d ms'):format(math.floor(ping * 1000 + 0.5)) or '-')
            FlashRate:Set(('%d / %d'):format(FlashTune.Hits, FlashTune.Attempts))
            local best, bestRate, bestN = nil, -1, 0
            for _, offset in ipairs(FlashTune.Candidates) do
                local entry = FlashTune.Stats[offset]
                if entry and entry.n >= FlashTune.MinSamples then
                    local rate = entry.hit / entry.n
                    if rate > bestRate then
                        best, bestRate, bestN = offset, rate, entry.n
                    end
                end
            end
            if best then
                FlashOffset:Set(('%+.0f ms  %d%% (n=%d)')
                    :format(best * 1000, math.floor(bestRate * 100), bestN))
            else
                FlashOffset:Set('learning')
            end
        end

        if ManjiConfig.AutoWindow then
            local learned, hits, misses = learnedWindow()
            if learned then
                ManjiWindow:Set(('%.2fs learned (%d/%d)'):format(learned, hits, hits + misses))
            else
                ManjiWindow:Set(('%.2fs set (%d hits so far)'):format(ManjiConfig.Window, hits or 0))
            end
        else
            ManjiWindow:Set(('%.2fs set'):format(ManjiConfig.Window))
        end

        if tick() - lastTimingRefresh > 4 then
            lastTimingRefresh = tick()
            pcall(refreshTimings)
            pcall(refreshOutcomes)
        end
    end
end)
