}

local AnimVariants = ReplicatedStorage.Animations.Itadori.Variants

local DIVERGENT_IDS = {
    [AnimVariants.DivergentFist1.AnimationId] = 1,
    [AnimVariants.DivergentFist2.AnimationId] = 2,
    [AnimVariants.DivergentFist3.AnimationId] = 3,
