-- Deliberately NOT Map:GetBoundingBox(). The game's debris PartCache parks
-- 2000 spare parts at CFrame.new(0, 10000000, 0) inside workspace.Map.Data, so
-- the map's bounding box is about five million studs tall - aiming at the top
-- of it just flies straight up forever, which is exactly what this used to do.
--
-- Instead the void is found the way it is actually defined: a spot where a ray
-- pointed straight down hits nothing. The filter mirrors the game's own ground
-- checks (Map + Domains), minus the Data folder holding the parked cache.
local voidParams = RaycastParams.new()
voidParams.FilterType = Enum.RaycastFilterType.Include
voidParams.IgnoreWater = true

local function refreshVoidFilter()
    local include = {}
    local map = workspace:FindFirstChild("Map")
    if map then
        for _, child in ipairs(map:GetChildren()) do
            if child.Name ~= "Data" then
                include[#include + 1] = child
            end
        end
    end
    local domains = workspace:FindFirstChild("Domains")
    if domains then include[#include + 1] = domains end
    voidParams.FilterDescendantsInstances = include
    return #include > 0
end

local function isOverVoid(position)
    local hit = workspace:Raycast(position, Vector3.new(0, -VoidConfig.ProbeDepth, 0), voidParams)
    return hit == nil
end

-- Scans outward by increasing radius so the first hit is the nearest edge,
-- which keeps the trip short. Pure raycasting, no movement - the character
-- does not budge until a destination is already known to be over nothing.
local COMPASS = {
    Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
    Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
    Vector3.new(0.707, 0, 0.707), Vector3.new(-0.707, 0, 0.707),
    Vector3.new(0.707, 0, -0.707), Vector3.new(-0.707, 0, -0.707),
}

local function findVoidTarget(fromPosition)
    if not refreshVoidFilter() then return nil, "no Map to scan" end

    -- Bias the search toward where the camera is already pointing, so when
    -- several edges are equally close it picks the one in front of you.
    local look = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.LookVector
    local ordered = {}
    if look then
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then ordered[1] = flat.Unit end
    end
    for _, dir in ipairs(COMPASS) do ordered[#ordered + 1] = dir end

    local step = 40
    for distance = step, VoidConfig.MaxTravel, step do
        for _, dir in ipairs(ordered) do
            local candidate = fromPosition + dir * distance
            if isOverVoid(candidate) then
                -- Push a little further past the lip so the victim is clearly
                -- out over nothing rather than teetering on the edge.
                local final = fromPosition + dir * (distance + VoidConfig.VoidMargin)
                if isOverVoid(final) then return final end
                return candidate
            end
        end
    end

    return nil, "no void found within range"
end

local moveParams = RaycastParams.new()
moveParams.FilterType = Enum.RaycastFilterType.Exclude
moveParams.IgnoreWater = true

-- Incremental, raycast-checked movement. The point of stepping instead of
-- teleporting is that every step is verified against geometry first, so the
-- character never passes through a wall - which is the thing most likely to be
-- noticed, far more than speed is.
local function flyTo(goal, victimChar, deadline)
    local root = getOwnRoot()
    if not root then return false end

    local ignore = { getOwnCharacter() }
    if victimChar then ignore[#ignore + 1] = victimChar end
    moveParams.FilterDescendantsInstances = ignore

    while tick() < deadline do
        root = getOwnRoot()
        if not root then return false end

        local current = root.Position
        local delta = goal - current
        local distance = delta.Magnitude
        if distance <= 2 then return true end

        local dt = RunService.Heartbeat:Wait()
        local stepLength = math.min(VoidConfig.FlySpeed * dt, distance)
        local direction = delta.Unit
        local nextPos = current + direction * stepLength

        local blocked = workspace:Raycast(current, nextPos - current, moveParams)
        if blocked then
            -- Something is in the way: climb over it rather than through it,
            -- and let the next iteration retry the horizontal leg.
            local lift = current + Vector3.new(0, VoidConfig.StepBlockedLift, 0)
            local liftBlocked = workspace:Raycast(current, Vector3.new(0, VoidConfig.StepBlockedLift, 0), moveParams)
            if liftBlocked then
                return false
            end
            root.CFrame = CFrame.new(lift, lift + Vector3.new(direction.X, 0, direction.Z))
        else
            local lookAt = nextPos + Vector3.new(direction.X, 0, direction.Z)
            if (Vector3.new(direction.X, 0, direction.Z)).Magnitude < 0.01 then
                lookAt = nextPos + root.CFrame.LookVector
            end
            root.CFrame = CFrame.new(nextPos, lookAt)
        end
    end

    return false
end

local function runVoidCarry(victimChar)
    if carryActive or not VoidConfig.Enabled then return end

    local root = getOwnRoot()
    if not root then return end

    carryActive = true
    local origin = root.CFrame
    VoidConfig.Status = "carrying"
    VoidConfig.LastFollowGap = -1

    local finished = false
    local function restore()
        if finished then return end
        finished = true
        local rootNow = getOwnRoot()
        if rootNow then rootNow.CFrame = origin end
        carryActive = false
    end

    task.spawn(function()
        local ok = pcall(function()
            local startPos = root.Position

            -- Altitude is relative to where you already are, not derived from
            -- the map, so it is always a sane number of studs.
            local cruiseY = startPos.Y + VoidConfig.Clearance
            local rise = Vector3.new(startPos.X, cruiseY, startPos.Z)

            -- Deadlines scale with the distance actually being covered rather
            -- than a flat guess, so a long crossing is not cut off halfway.
            local function deadlineFor(from, to)
                return tick() + 1.5 + (to - from).Magnitude / math.max(VoidConfig.FlySpeed, 1)
            end

            VoidConfig.Status = "ascending"
            if not flyTo(rise, victimChar, deadlineFor(startPos, rise)) then
                VoidConfig.Status = "blocked on ascent"
                return
            end

            local currentRoot = getOwnRoot()
            local cruisePos = currentRoot and currentRoot.Position or rise

            VoidConfig.Status = "looking for an edge"
            local voidPoint, reason = findVoidTarget(cruisePos)
            if not voidPoint then
                VoidConfig.Status = reason or "no void found"
                return
            end

            VoidConfig.Status = "crossing out"
            if not flyTo(voidPoint, victimChar, deadlineFor(cruisePos, voidPoint)) then
                VoidConfig.Status = "blocked crossing out"
                return
            end

            VoidConfig.Status = "over the void"

            -- Hold position while the victim is out here with us, and watch
            -- whether they are actually following. If the server does not keep
            -- them attached through the combo this gap grows immediately, which
            -- is the honest signal that the carry did nothing.
            local holdUntil = tick() + VoidConfig.CarryDuration
            while tick() < holdUntil do
                local rootNow = getOwnRoot()
                local hum = getOwnHumanoid()
                if not rootNow or not hum or hum.Health <= 0 then break end

                rootNow.CFrame = CFrame.new(voidPoint, voidPoint + rootNow.CFrame.LookVector)

                if victimChar then
                    local victimRoot = victimChar:FindFirstChild("HumanoidRootPart")
                    if victimRoot then
                        VoidConfig.LastFollowGap = (victimRoot.Position - rootNow.Position).Magnitude
                    end
                end

                RunService.Heartbeat:Wait()
            end

            VoidConfig.Status = "returning"
        end)

        if not ok then
            VoidConfig.Status = "errored"
        end
        restore()
        if VoidConfig.Status == "returning" or VoidConfig.Status == "over the void" then
            VoidConfig.Status = "done"
        end
    end)
end

if CursedStrikesEffects then
    CursedStrikesEffects.OnClientEvent:Connect(function(key, a, b)
        if not VoidConfig.Enabled or carryActive then return end

        if key == "FinalHit" then
            -- FinalHit(attacker, victim): unambiguous, no window needed.
            if isOwnCharacter(a) and b and not isOwnCharacter(b) then
                runVoidCarry(b)
            end
        elseif key == "Hit" then
            -- Hit(victim, ...): only ours if we just used the move.
            if tick() - lastActivatedAt <= ACTIVATION_WINDOW and a and not isOwnCharacter(a) then
                runVoidCarry(a)
            end
        end
    end)
end

