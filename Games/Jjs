                canBurst(target) and COLOR_BAD or COLOR_GOOD)
        else
            TName:Set('-')
            TDist:Set('-')
            TState:Set('-')
            TEvade:Set(0)
            TBurst:Set('-')
        end

        if tick() - lastTimingRefresh > 4 then
