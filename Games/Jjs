local function refreshTimings()
    local rows = {}
    for key, entry in pairs(Intel.Timing) do
        if entry.n > 0 then
            table.insert(rows, { key = key, entry = entry })
        end
    end
    table.sort(rows, function(a, b)
        if a.entry.n ~= b.entry.n then
            return a.entry.n > b.entry.n
        end
        return a.key < b.key
    end)
    TimingLog:Clear()
    if #rows == 0 then
        TimingLog:Add('nothing measured yet - take a few hits')
    end
    for _, row in ipairs(rows) do
        local e = row.entry
        local tag = e.ragdoll > 0.5 and ' rag' or ''
        local known = learnedReach(row.key)
        local reach = known and ('%4.0fst'):format(known) or '   -  '
        TimingLog:Add(('%-24s %5.2fs %5.2fs %s (%d)%s')
            :format(row.key:sub(1, 24), e.lead, e.dur, reach, e.n, tag))
    end
    MoveStat:Set(tostring(#rows))
    SampleStat:Set(tostring(Intel.Samples))
    HookedStat:Set(tostring(Intel.Hooked))
end

