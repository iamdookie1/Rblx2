local function currentTarget()
    local controller = toolController()
    if controller then
        local ok, target = pcall(function()
            return controller:GetTarget()
        end)
        if ok and typeof(target) == 'Instance' and target:IsA('Model') then
            return target
        end
    end
    -- No lock-on, so fall back to the nearest other character in range.
    local folder = charactersFolder()
    local mine = ownCharacter()
    if not folder or not mine then return nil end
    local best, bestDistance = nil, IntelConfig.Range
    for _, char in ipairs(folder:GetChildren()) do
        if not isOwn(char) and char:FindFirstChild('HumanoidRootPart') then
            local distance = distanceTo(char)
            if distance < bestDistance then
                best, bestDistance = char, distance
            end
        end
    end
    return best
end

