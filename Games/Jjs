    MaxLines = 80,
})

local function refreshOutcomes()
    local rows = {}
    for key, entry in pairs(Outcomes.Moves) do
        local total = entry.blocked + entry.pierced + entry.countered + entry.whiffed
        if total > 0 then
            table.insert(rows, { key = key, entry = entry, total = total })
        end
    end
    table.sort(rows, function(a, b) return a.total > b.total end)
    OutcomeLog:Clear()
    if #rows == 0 then
        OutcomeLog:Add('nothing tried yet - block or counter something')
    end
    for _, row in ipairs(rows) do
        local e = row.entry
        local named = blockVerdict(row.key)
        local verdict = named == 'unknown' and '' or ('  ' .. named)
        OutcomeLog:Add(('%-24s %d/%d  %d/%d%s'):format(
            row.key:sub(1, 24), e.blocked, e.blocked + e.pierced,
            e.countered, e.countered + e.whiffed, verdict))
    end
end

OutcomeSection:Buttons({
    { Title = 'refresh', Callback = refreshOutcomes },
    {
        Title = 'reset',
        Callback = function()
            Outcomes.Moves = {}
            table.clear(Outcomes.Throws)
            refreshOutcomes()
        end,
    },
})

OutcomeSection:Paragraph({
    Title = 'where these come from',
    Text = 'Every guard anyone on the server puts up is a sample, not just ours. BlockService announces a block absorbing a hit for whoever blocked it, and Info is readable on everyone, so blocked and pierced are counted across the whole lobby. That is the difference between classifying a move the first time somebody else eats it and never classifying it until we personally tried. countered still comes from a ManjiKick Hit naming us. All of it is server broadcast, so these are observations - but they describe what happened at that angle and range, not a property of the move.',
})

OutcomeSection:Paragraph({
    Title = 'the verdicts',
    Text = 'unknown means fewer than three attempts have been seen and it will not refuse to block on that basis. unblockable means under a third of guards survived it, and auto block stops offering itself up - though it still tries occasionally, so a wrong call can correct itself. blockable means over two thirds held. The same function decides the label and the behaviour, so they cannot disagree.',
})

local CounterNotes = CounterTab:Section({ Title = 'what this can and cannot know', Side = 'left' })

CounterNotes:Paragraph({
    Title = 'not readable',
    Text = 'Whether an attack is blockable, whether it is 360-blockable, and its attack type - which is what decides whether a counter catches it - all live in server scripts. No client can read them. So neither toggle knows whether a given attack is actually counterable or blockable.',
})

CounterNotes:Paragraph({
    Title = 'what it gates on instead',
    Text = 'Manji gates on timing: it only goes out when the hit is due inside the counter window, so it is not spent on something landing after the counter expires. Block deliberately does not - attacks come in chains, and a guard that goes up late for the first hit still stops the next three, so missing a window is no reason to stand there unguarded. It gates on the attack being inside your facing cone instead, because a block facing the wrong way gets broken anyway and one that snaps to a hit from behind is the obvious tell.',
})

CounterNotes:Paragraph({
    Title = 'ranged attacks',
    Text = 'Reach is measured, not set. Every sample records how far away the attacker was, and a move\'s reach is the second furthest it has connected from over its last two dozen samples - second, not furthest, so one mis-blamed sample cannot decide it. Until a move has four samples the slider stands in, and it is set short on purpose: assume melee and let evidence extend it, never the other way round.',
})

CounterNotes:Paragraph({
    Title = 'facing',
    Text = 'The attacker always has to be pointed roughly this way - the cone just widens up close, where a swing can still turn into you, and tightens at range where it cannot. Somebody with their back to you fails at any distance.',
})

CounterNotes:Paragraph({
    Title = 'untested',
    Text = 'None of this has been run in-game yet. The remotes and attributes are read straight from the dump, but the reaction and window defaults are starting points, not measurements.',
})

